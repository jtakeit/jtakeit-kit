    {
      "name": "the least a schema says",
      "expect": "",
      "catalogue": {"contract": 3, "locale": "de", "blocks": [{"type": "hero", "v": 1, "label": "Hero", "fields": [{"key": "title", "label": "Titel", "kind": "text"}]}]}
    },
    {
      "name": "everything contract 3 adds, said where it may be said",
      "expect": "",
      "catalogue": {
        "contract": 3, "generator": "test", "locale": "de", "locales": ["en"],
        "blocks": [
          {"type": "product", "v": 1, "label": "Produkt", "fields": [
            {"key": "title", "label": "Name", "kind": "text", "required": true, "max": 80},
            {"key": "sku", "label": "Artikelnummer", "kind": "sku"},
            {"key": "price", "label": "Preis", "kind": "money", "qualifiers": ["from", "on_request"], "min": 0},
            {"key": "weight", "label": "Gewicht", "kind": "number", "integer": true},
            {"key": "colour", "label": "Farbe", "kind": "select", "options": [{"value": "red", "label": {"de": "Rot", "en": "Red"}}, {"value": "oak"}]},
            {"key": "category", "label": "Kategorie", "kind": "ref", "ref": {"to": ["categories"], "on_delete": "nullify"}},
            {"key": "related", "label": "Dazu", "kind": "ref", "ref": {"to": ["categories", "tags"], "many": true}},
            {"key": "photo", "label": "Bild", "kind": "media", "ratio": "3:2", "localized": true},
            {"key": "clip", "label": "Film", "kind": "media", "accept": "video"},
            {"key": "options", "label": "Optionen", "kind": "list", "of": [
              {"key": "name", "label": "Name", "kind": "text"},
              {"key": "values", "label": "Werte", "kind": "list", "of": [{"key": "label", "label": "Wert", "kind": "text"}]}
            ]}
          ]},
          {"type": "category", "v": 1, "label": "Kategorie", "fields": [
            {"key": "title", "label": "Name", "kind": "text", "required": true},
            {"key": "parent", "label": "Oben", "kind": "ref", "ref": {"to": ["categories"]}}
          ]},
          {"type": "tag", "v": 1, "label": "Schlagwort", "fields": [{"key": "title", "label": "Name", "kind": "text", "required": true}]},
          {"type": "contacts", "v": 1, "label": "Kontakt", "fields": [
            {"key": "name", "label": "Name", "kind": "text", "role": "name"},
            {"key": "phone", "label": "Telefon", "kind": "tel", "role": "phone"},
            {"key": "social", "label": "Profile", "kind": "list", "role": "social", "of": [{"key": "url", "label": "Adresse", "kind": "url"}]}
          ]}
        ],
        "page_seo": [{"key": "title", "label": "Titel", "kind": "text", "localized": true}],
        "shared": ["contacts"],
        "collections": [
          {"name": "products", "label": "Produkte", "type": "product", "route": {"detail": {"de": "/produkte/{slug}", "en": "/products/{slug}"}, "listing": "/produkte", "per_page": 12}, "order": {"by": "title"}, "group": "category", "untranslated": "hide"},
          {"name": "categories", "label": "Kategorien", "type": "category", "route": {"detail": "/kategorien/{slug}"}, "order": "manual"},
          {"name": "tags", "label": "Schlagworte", "type": "tag", "route": "none", "shown_on": ["/schlagworte#tag-{slug}", {"de": "/start#{slug}", "en": "/home#{slug}"}]}
        ]
      }
    },

