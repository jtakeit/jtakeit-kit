---
/**
 * Where to find the business, in the gloss look: the block's heading and a
 * line, then the address with a link to the map, the hours with «open now»,
 * the telephone and the email, and the business's Instagram — all of it the
 * shared text's (`contacts`, and the hours the diary's where it takes
 * bookings), tapped and changed in the panel, never typed here.
 *
 * The form's own block (`cta_banner`): with `form: true` the enquiry form
 * stands on the left (the template's LeadForm, every word the block's), as in
 * every look; a booking page has it off, since the page books.
 *
 * No embedded map: it would put a third party on the page before anybody
 * asked. A link to the map the contacts name (`maps`) does the job.
 *
 * `#contact`, where every button with no link of its own leads. The card is
 * also `reach__card`, the name the foot looks for to leave out its own copy of
 * the address and the hours on this page.
 */
import type { Block } from '@jtakeit/kit/content';
import LeadForm from '../LeadForm.astro';
import Hours from '../site/Hours.astro';
import Label from '../site/Label.astro';
import { frameLang, frameWords } from '../site/words';
import { site } from '../../lib/site';
import { langOf } from '../../lib/locale';

interface Props {
  block: Block;
  locale: string;
  contact?: boolean;
}

const { block, locale, contact = false } = Astro.props;
const lang = langOf(locale);
const W = frameWords(lang);
const wordsLang = frameLang(lang);
const facts = site.facts(locale);
const contacts = site.shared(locale).block('contacts');
const hours = site.shared(locale).block('hours');
const street = facts.text('street');
const postal = facts.text('postal_code');
const city = facts.text('city');
const maps = facts.text('maps');
const phone = facts.text('phone');
const email = facts.text('email');
const social = facts.rows('social').filter((row) => row.text('url'));
const form = block.value('form') === true;
---

<section class:list={['s', 'visit', form && 'visit--form']} id={contact ? 'contact' : undefined}>
  <div class="s__in visit__in">
    <div class="visit__lead" data-reveal="float">
      {
        form ? (
          <LeadForm />
        ) : (
          <div class="s__head visit__head">
            {block.text('title') && <h2 class="s__title" {...{ ...block.at('title'), ...block.lang('title') }}>{block.text('title')}</h2>}
            {block.text('lead') && <p class="s__lead" {...{ ...block.at('lead'), ...block.lang('lead') }}>{block.text('lead')}</p>}
          </div>
        )
      }
      {
        !form && social.length > 0 && (
          <ul class="visit__social">
            {social.map((row) => {
              const url = row.text('url');
              const insta = /instagram\.com/i.test(url);
              const handle = insta ? (/instagram\.com\/([^/?#]+)/i.exec(url)?.[1] ?? '') : '';
              return (
                <li>
                  <a class="visit__follow" href={url} rel="noopener me" target="_blank">
                    {insta && (
                      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
                        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5" />
                        <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" />
                      </svg>
                    )}
                    {row.text('label') ? <span {...{ ...row.at('label'), ...row.lang('label') }}>{row.text('label')}</span> : <span data-jtk-fixed>{handle ? `@${handle}` : url.replace(/^https?:\/\/(www\.)?/, '')}</span>}
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>

    <aside class="visit__card reach__card" {...facts.from()} data-reveal="float" style="--i:1">
      {
        (street || postal || city) && (
          <div class="visit__part">
            <Label of={contacts} field="address_label" standIn={W.address} standInLang={wordsLang} />
            <address class="visit__addr">
              {street && <span {...facts.at('street')}>{street}</span>}
              {(postal || city) && (
                <span>
                  {postal && <span {...facts.at('postal_code')}>{postal}</span>} {city && <span {...{ ...facts.at('city'), ...contacts.lang('city') }}>{city}</span>}
                </span>
              )}
            </address>
            {maps && (
              <a class="visit__map" href={maps} rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                {contacts.text('maps_label') ? <span {...{ ...contacts.at('maps_label'), ...contacts.lang('maps_label') }}>{contacts.text('maps_label')}</span> : <span {...contacts.at('maps_label')} lang={wordsLang}>{W.directions}</span>}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        )
      }
      <div class="visit__part">
        <Label of={hours} field="label" standIn={W.hours} standInLang={wordsLang} />
        <Hours locale={locale} />
      </div>
      {
        (phone || email) && (
          <div class="visit__part">
            <Label of={contacts} field="reach_label" standIn={W.write} standInLang={wordsLang} />
            <p class="visit__lines">
              {phone && <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} {...facts.at('phone')}>{phone}</a>}
              {email && <a href={`mailto:${email}`} {...facts.at('email')}>{email}</a>}
            </p>
          </div>
        )
      }
    </aside>
  </div>
</section>

<style>
  .visit__in {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .visit--form .visit__in {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .visit__head {
    margin-block-end: var(--space-6);
  }

  .visit__social {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .visit__follow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    text-decoration: none;
    transition: color 200ms var(--ease-out);
  }

  .visit__follow:hover {
    color: var(--accent-ink);
  }

  .visit__follow svg {
    flex: none;
    color: var(--accent-ink);
  }

  .visit__card {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-radius: var(--r-4);
    background: var(--panel);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--ink) 7%, transparent),
      var(--lift-shadow);
  }

  .visit__part {
    display: grid;
    gap: 0.75rem;
  }

  .visit__addr {
    display: grid;
    font-style: normal;
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .visit__map {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    inline-size: fit-content;
    min-block-size: 2.5rem;
    padding: 0 1rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--accent) 9%, transparent);
    color: var(--accent-ink);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 200ms var(--ease-out);
  }

  .visit__map:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .visit__lines {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    font-size: var(--step-1);
  }

  .visit__lines a {
    inline-size: fit-content;
    color: var(--ink);
    text-decoration: none;
    border-block-end: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }

  /* ── the template's form, in the look ─────────────────────────────────── */

  .visit__lead :global(.lead) {
    max-inline-size: none;
    gap: 1.4rem;
  }

  .visit__lead :global(.lead__head) {
    display: grid;
    gap: var(--space-4);
    margin-block-end: var(--space-4);
  }

  .visit__lead :global(.lead__title) {
    margin: 0;
    color: var(--ink);
    font-size: var(--step-4);
    line-height: 1.02;
  }

  .visit__lead :global(.lead__lead) {
    margin: 0;
    max-inline-size: var(--measure);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-quiet);
  }

  .visit__lead :global(.field__label) {
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-quiet);
  }

  .visit__lead :global(.field__input) {
    inline-size: 100%;
    min-block-size: 3.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--panel);
    font-size: 1rem;
  }

  .visit__lead :global(.field__input:focus-visible) {
    outline: none;
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .visit__lead :global(.field__input--area) {
    min-block-size: 8rem;
  }

  .visit__lead :global(.lead__legal) {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-quiet);
  }

  .visit__lead :global(.lead__foot .btn) {
    min-block-size: 3.25rem;
    padding-inline: 1.75rem;
    border-radius: var(--r-pill);
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .visit__in,
    .visit--form .visit__in {
      grid-template-columns: 1fr;
    }
  }
</style>
