---
/**
 * What people said, as quotations: the words, the name and a line under each
 * — no stars and no rating. The example's are signed «an example», because a
 * review nobody wrote is the one leftover that could do harm: replace them
 * with real ones, with their source, or `jtk remove testimonials`.
 */
import type { Block } from '@jtakeit/kit/content';

interface Props {
  block: Block;
  first?: boolean;
}

const { block, first = false } = Astro.props;
const items = block.rows('items');
---

<section class="section quotes" id={first ? 'testimonials' : undefined}>
  <div class="section__in">
    <div class="section__head">
      {block.text('eyebrow') && <p class="label" {...{ ...block.at('eyebrow'), ...block.lang('eyebrow') }}>{block.text('eyebrow')}</p>}
      {block.text('title') && <h2 {...{ ...block.at('title'), ...block.lang('title') }}>{block.text('title')}</h2>}
    </div>
    {
      items.length > 0 && (
        <ul class="quotes__list" tabindex="0">
          {items.map((row) => (
            <li class="quotes__one">
              {row.text('quote') && (
                <blockquote class="quotes__words">
                  <p {...{ ...row.at('quote'), ...row.lang('quote') }}>{row.text('quote')}</p>
                </blockquote>
              )}
              <p class="quotes__who">
                {row.text('name') && <span {...{ ...row.at('name'), ...row.lang('name') }}>{row.text('name')}</span>}
                {row.text('detail') && <span class="label" {...{ ...row.at('detail'), ...row.lang('detail') }}>{row.text('detail')}</span>}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .quotes__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quotes__one {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--line);
  }

  .quotes__words {
    margin: 0;
  }

  .quotes__who {
    display: grid;
    gap: var(--space-1);
    font-weight: 600;
  }
  /*
   * On a phone what clients say — a row of up to seven things — is a swipe with a peek,
   * not a tower (docs/compositions.md, «Phones»): one row, each a little
   * narrower than the screen so the next shows at its edge, from the screen's
   * edge to the screen's edge. Focusable, so a keyboard scrolls it too.
   */
  @media (max-width: 40rem) {
    .quotes__list {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(17rem, 78%);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-block-end: var(--space-2);
    }
    .quotes__list > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>
