---
/**
 * The page's button, in its two weights: clear glass with the accent disc and
 * its arrow, or quiet glass with the arrow in the words. The material is
 * look.css's; this writes the markup once, so the arrows are never typed out
 * by hand in five places.
 *
 * `at` is the label's annotation — `{...block.at('cta_label')}` — where the
 * words are content, and `lang` its language where it is the original's on a
 * page in another. `href` is written under the build's base by the caller
 * (`linkTo`), so the preview's `/p/<slug>/` holds.
 */
interface Props {
  href: string;
  label: string;
  at?: Record<string, string | undefined>;
  lang?: { lang?: string };
  /** `data-jtk-href`: where the panel edits the link beside the words, when the owner may. */
  hrefAt?: string;
  quiet?: boolean;
  small?: boolean;
  class?: string;
}

const { href, label, at = {}, lang = {}, hrefAt, quiet = false, small = false, class: extra } = Astro.props;
const arrow = 'M1 6h11M8 2l4 4-4 4';
---

<a class:list={['b', 'glass', { 'b--quiet': quiet, 'b--small': small }, extra]} href={href} data-jtk-href={hrefAt}>
  <span {...at} {...lang}>{label}</span>
  {
    quiet ? (
      <svg class="b__go" width="13" height="12" viewBox="0 0 13 12" fill="none" aria-hidden="true">
        <path d={arrow} stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    ) : (
      <span class="b__disc" aria-hidden="true">
        <svg width="13" height="12" viewBox="0 0 13 12" fill="none">
          <path d={arrow} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg width="13" height="12" viewBox="0 0 13 12" fill="none">
          <path d={arrow} stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    )
  }
</a>
