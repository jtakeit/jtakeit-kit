---
/**
 * A heading of the frame — «Address», «Opening hours», «Write or call» —
 * that is the business's to say where it says it: its shared field's words,
 * annotated, where they are written; the kit's word in the page's language
 * where they are not — annotated with the same field, so a tap on the
 * stand-in opens the empty field to be filled (jtakeit-core wiki/111 §3.3 and
 * T11, the owner's Q3). An owner who wants «Kontakt» writes it; nobody has to
 * translate the stand-in.
 */
import type { Values } from '@jtakeit/kit/content';

interface Props {
  /** The values the words are a field of: the contacts' block, the hours'. */
  of: Values;
  field: string;
  /** The kit's word, when the field is empty. */
  standIn: string;
  /** The stand-in's language where it is not the page's (`frameLang`). */
  standInLang?: string;
  class?: string;
}

const { of, field, standIn, standInLang, class: extra = 'label' } = Astro.props;
const own = of.text(field);
---

{/* Tapped either way (wiki/111 T11: their eyebrows annotated): the stand-in opens the empty field to be filled. */}
{own ? <p class={extra} {...{ ...of.at(field), ...of.lang(field) }}>{own}</p> : <p class={extra} {...of.at(field)} lang={standInLang}>{standIn}</p>}
