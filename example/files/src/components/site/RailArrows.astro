---
/**
 * The two arrows that move a rail (site/rail.ts), drawn beside a section's
 * heading. Hidden until the script has seen that the row is wider than the
 * screen — a row that shows everything has nothing to move to.
 */
import { langOf } from '../../lib/locale';

interface Props {
  /** The id of the rail they move. */
  for: string;
  locale: string;
}
const { for: rail, locale } = Astro.props;
const WORDS: Record<string, [string, string]> = {
  en: ['Back', 'More'],
  de: ['Zurück', 'Weiter'],
  fr: ['Précédent', 'Suivant'],
  it: ['Indietro', 'Avanti'],
  es: ['Anterior', 'Siguiente'],
  pt: ['Anterior', 'Seguinte'],
  pl: ['Wstecz', 'Dalej'],
  uk: ['Назад', 'Далі'],
  ru: ['Назад', 'Дальше'],
};
const lang = langOf(locale).slice(0, 2);
const [back, more] = WORDS[lang] ?? WORDS.en;
---

<div class="rail-arrows" data-rail-arrows hidden>
  <button type="button" class="rail-arrows__b" data-rail-prev data-rail-for={rail} aria-controls={rail} aria-label={back} hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <button type="button" class="rail-arrows__b" data-rail-next data-rail-for={rail} aria-controls={rail} aria-label={more} hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
</div>

<style>
  .rail-arrows {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }
  .rail-arrows[hidden] {
    display: none;
  }
  .rail-arrows__b {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface, #fff) 80%, transparent);
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      opacity 200ms var(--ease-out);
  }
  .rail-arrows__b:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    background: var(--surface, #fff);
    color: var(--accent-ink);
  }
  .rail-arrows__b:focus-visible {
    outline: 2px solid var(--accent-ink);
    outline-offset: 3px;
  }
  .rail-arrows__b:disabled {
    opacity: 0.35;
    cursor: default;
  }
</style>
