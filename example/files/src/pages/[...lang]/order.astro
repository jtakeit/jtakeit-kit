---
/**
 * The page after payment — `/order`, and `/<lang>/order` in each language the
 * site has (jtakeit-core wiki/102 stage 9, decision 6): where the checkout's
 * `return` brings the buyer back from Stripe's page, with `order=<token>` on
 * the address.
 *
 * `jtk add shop` lays it with `src/components/shop/OrderAfter.astro`, which
 * draws the order — the markup and the look are the site's. This page is the
 * frame: the heading and the order under it. It is built only where the schema
 * turns the shop on, so a site that took the shop out has no order route left
 * behind.
 *
 * Its words are the kit's (`@jtakeit/kit/shop/words`, in the page's language),
 * not the page's content: the order is nobody's to write, so the panel has
 * nothing here to tap. It carries no `noindex` — the layout has no per-page
 * robots — and the sitemap, which lists the content's pages, leaves it out. It
 * offers no switch of language either: the buyer's order is the token on this
 * address, which another language's page would not have.
 */
import Layout from '../../layouts/Layout.astro';
import OrderAfter from '../../components/shop/OrderAfter.astro';
import { shopWordsFor } from '@jtakeit/kit/shop/words';
import { site } from '../../lib/site';
import { langOf, localeOf, localeParams } from '../../lib/locale';

export function getStaticPaths() {
  return site.rolesOf('shop') === undefined ? [] : localeParams();
}

const locale = localeOf(Astro.url.pathname);
const W = shopWordsFor(langOf(locale));
---

<Layout title={W.order} description={W.order} languages={[]}>
  <main id="content" class="order-page">
    <h1 data-jtk-fixed>{W.order}</h1>
    <OrderAfter locale={locale} />
  </main>
</Layout>

<style>
  .order-page {
    display: grid;
    gap: var(--space-5, 1.5rem);
    width: min(var(--shell, 72rem), 100%);
    margin: 0 auto;
    /* Clear of the header that floats over the page, as the example's entries are (look.css, `.entry`) — or as far as the look says (`--page-top`: the bare look's header is in the flow). */
    padding: var(--page-top, clamp(7rem, 16vh, 10rem)) var(--gutter, 1.25rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .order-page > * {
    min-width: 0;
  }
  .order-page h1 {
    margin: 0;
    font-size: var(--step-3, 2rem);
    line-height: 1.05;
  }
</style>
