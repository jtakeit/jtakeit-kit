---
/**
 * The cart's page — `/cart`, and `/<lang>/cart` in each language the site has
 * (jtakeit-core wiki/102 stage 9, decision 6).
 *
 * `jtk add shop` lays it with `src/components/shop/Cart.astro`, which draws
 * the cart and is where the markup and the look are the site's. This page is
 * the frame: the heading, and the cart under it; the checkout step goes below
 * the cart on the same page. It is built only where the schema turns the shop
 * on, so a site that took the shop out has no cart route left behind.
 *
 * Its words are the kit's (`@jtakeit/kit/shop/words`, in the page's language),
 * not the page's content: the cart is nobody's to write, so the panel has
 * nothing here to tap. It carries no `noindex` — the layout has no per-page
 * robots — and the sitemap, which lists the content's pages, leaves it out.
 */
import Layout from '../../layouts/Layout.astro';
import Cart from '../../components/shop/Cart.astro';
import { shopWordsFor } from '@jtakeit/kit/shop/words';
import { site } from '../../lib/site';
import { EVERY_LOCALE, langOf, localeOf, localeParams, withLocale } from '../../lib/locale';

export function getStaticPaths() {
  return site.rolesOf('shop') === undefined ? [] : localeParams();
}

const locale = localeOf(Astro.url.pathname);
const W = shopWordsFor(langOf(locale));
// The language switch goes to the cart in each language the site has — the cart has no translations to be missing.
const languages = EVERY_LOCALE.length > 1 ? EVERY_LOCALE.map((one) => ({ locale: one, address: withLocale(one, '/cart') })) : [];
---

<Layout title={W.cart} description={W.cart} languages={languages}>
  <main id="content" class="cart-page">
    <h1 data-jtk-fixed>{W.cart}</h1>
    <Cart locale={locale} />
  </main>
</Layout>

<style>
  .cart-page {
    display: grid;
    gap: var(--space-5, 1.5rem);
    width: min(var(--shell, 72rem), 100%);
    margin: 0 auto;
    /* Clear of the header that floats over the page, as the example's entries are (look.css, `.entry`). */
    padding: clamp(7rem, 16vh, 10rem) var(--gutter, 1.25rem) clamp(2.5rem, 6vw, 4.5rem);
  }
  .cart-page > * {
    min-width: 0;
  }
  .cart-page h1 {
    margin: 0;
    font-size: var(--step-3, 2rem);
    line-height: 1.05;
  }
</style>
