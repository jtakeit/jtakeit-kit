{
  "name": "@jtakeit/astro",
  "version": "0.17.0",
  "description": "The Astro scaffold and the catalogue tool for a site on jtakeit — the platform's contract, ready to build on",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jtk": "bin/jtk.mjs"
  },
  "files": [
    "bin",
    "lib",
    "template",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtakeit/jtakeit-kit.git"
  },
  "homepage": "https://github.com/jtakeit/jtakeit-kit#readme",
  "keywords": [
    "jtakeit",
    "astro",
    "scaffold",
    "catalogue",
    "agent"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node --test test/code.test.mjs test/code-wire.test.mjs && npm test --workspace kit",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@jtakeit/kit": "0.14.0",
    "ignore": "7.0.14"
  },
  "workspaces": [
    "kit"
  ],
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright-core": "1.65.0"
  },
  "bugs": {
    "url": "https://github.com/jtakeit/jtakeit-kit/issues"
  }
}
