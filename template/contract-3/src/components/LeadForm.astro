---
/**
 * The lead form — `@jtakeit/kit`'s, placed by this page.
 *
 * The markup is `renderLeadForm`'s and the in-place submission is the kit's
 * `<jtk-lead>` element; this component reads the site's words and the
 * collecting block's `asks`, and says where `/api/lead` is from here. It is
 * a real `<form method="post">` first: with JavaScript off the browser posts
 * to the same endpoint and the platform answers with a plain page.
 *
 * `novalidate` because the messages are ours, in the client's language, rather
 * than the browser's in the browser's. Every rule enforced here is enforced
 * again by the platform behind /api/lead — the endpoint is public and the
 * browser's checks are a convenience, not a gate.
 *
 * ── every word a visitor reads on it is the block's ─────────────────────────
 *
 * `FORM` is the `cta_banner` block's own fields — the heading, the lead, the
 * words over the name, the contact and the message, the button — and each
 * question in `asks` is drawn under the block's `<key>_label` field (the
 * scaffold's `topic` under `topic_label`). So every word on the form is the
 * owner's to change and to translate by tapping it, like any other text on
 * the page: in the site's language in `jtk/pages/index.json`, and in each
 * other language in its translation, `jtk/pages/index.<locale>.json`, which
 * `jtk create` and `npx @jtakeit/astro copy <locale>` fill in the kit's words.
 *
 * The declaration's `label` of an ask is what the owner's inbox, the
 * notification and the export name the answer by. It is drawn only where the
 * block declares no `<key>_label` — fixed, as declared — and stands in, at
 * the field's path, where the block leaves its words empty. See the comment
 * on `asks` in blocks.ts for what the platform holds the form to.
 */
import { renderLeadForm } from '@jtakeit/kit/lead';
import '@jtakeit/kit/lead.css';
import { copyFor } from '../copy';
import { localeOf, langOf, withLocale } from '../lib/locale';
import { site } from '../lib/site';
import { under } from '../lib/under';

const locale = localeOf(Astro.url.pathname);
const LANG = langOf(locale);
const { FORM, PAGE, WORDS_LANG } = copyFor(locale);

// The block's declaration, as the schema the platform reads has it
// (jtk/schema.json, through the door).
const block = site.type('cta_banner');
const declared = block?.asks ?? [];
// The photographs the form takes, as the block declares them (blocks.ts);
// the kit draws the picker in the page's language.
const photos = block?.photos ?? 0;
// The block on this language's home page, and the fields its type declares.
const cta = PAGE.block('cta_banner');
const fields = new Set((block?.fields ?? []).map((field) => field.key));

// A path is undefined on a build without annotations, and the kit then
// writes no `data-jtk-path` at all.
//
// The paths are the home page's of this language: its copy reads the page
// at `/` (or `/de`), and `blocks[ctab0001].title` is that document's block of
// that key. On any other page the same path names a block that page does not
// have, and the annotation lint says so seventy times on a site of eleven
// pages (a bowling club, 8 October 2026). So the form annotates only where
// its block lives; elsewhere it is the same form, editable from the index.
const home = withLocale(locale, '/');
const onIndex = [home, `${home}/`, `/${LANG}`, `/${LANG}/`].includes(Astro.url.pathname.replace(/^\/p\/[^/]+/, '') || '/');
const at = (field: string) => (onIndex ? cta.at(field)['data-jtk-path'] : undefined);
// The original's words, on a page in a language nobody translated them into, say so.
const lang = (field: string) => cta.lang(field).lang || undefined;
const OWN = ['title', 'lead', 'name_label', 'contact_label', 'message_label', 'required_note', 'cta_label'] as const;
const paths = Object.fromEntries(OWN.map((field) => [field, at(field)]));
const langs = Object.fromEntries(OWN.map((field) => [field, lang(field)]));

const asks = declared.map((ask) => {
  // The words over the control: the block's `<key>_label`, where it declares one.
  const own = `${ask.key}_label`;
  const said = fields.has(own) ? cta.text(own) : '';
  return {
    key: ask.key,
    label: said || site.words(ask.label, LANG),
    // Tappable where the block keeps the words; the declaration's, fixed, where it does not.
    path: fields.has(own) ? at(own) : undefined,
    // Whose words they are, where they are not this page's language.
    lang: (said ? lang(own) : site.wordsLang(ask.label, LANG)) || undefined,
    kind: ask.kind,
    required: ask.required,
    max: ask.max,
    min: ask.min,
    options: (ask.options ?? []).map((value) => ({ value, label: site.words(ask.option_labels?.[value], LANG) })),
  };
});

const html = renderLeadForm({ action: under('/api/lead'), copy: FORM, asks, paths, langs, photos, lang: LANG, wordsLang: WORDS_LANG });
---

<Fragment set:html={html} />

<script>
  import '@jtakeit/kit/elements/lead';
</script>
