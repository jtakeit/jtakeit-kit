---
import DESIGN from '../../jtk/design.json';
/**
 * The document. Written once, derived from data, never repeated per page.
 *
 * Everything SEO-shaped here comes out of the shared text, src/data/site.ts
 * and src/copy — the host from the build, the business's facts from the
 * shared text the owner edits (`site.facts`, by role) and src/data/site.ts
 * where it says nothing, the indexability from one flag. There is
 * deliberately no second place to change any of them.
 */
import { BUSINESS, INDEXABLE, SCHEMA_TYPE, canonicalFor } from '../data/site';
import { site } from '../lib/site';
import { under } from '../lib/under';
import { copyFor } from '../copy';
import { localeOf, langOf } from '../lib/locale';
import Languages from '../components/Languages.astro';
import { RASTER_MARK } from '../lib/icon';
import { FRAME } from '../lib/sections';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set false on the home page, whose title is already complete. */
  suffix?: boolean;
  /** Extra JSON-LD for this page — a Service, an Offer, an FAQPage. */
  schema?: unknown;
  bodyClass?: string;
  /**
   * Every language this page exists in — `site.alternatesOf(page)`, the
   * door's, for a page or an entry.
   *
   * Without it two language versions of one page compete with each other in
   * search, which is the only part of being multilingual that costs money. A
   * page in one language passes nothing and nothing is emitted; a `hreflang`
   * set of one is noise.
   */
  alternates?: { locale: string; address: string }[];
  /**
   * Every language the page can be read in, for the language switch —
   * `site.languagesOf(page)`: the switch goes to a page in another language
   * whether or not anybody translated it, where `hreflang` names only the
   * translated (contract 3). The alternates where it is not given.
   */
  languages?: { locale: string; address: string }[];
}

const { title, description, suffix = true, schema, bodyClass, alternates = [], languages = alternates } = Astro.props;
/*
 * The site's frame, where it has one: its look in the head, a header above the
 * page and a footer below it (src/components/site/, src/lib/sections.ts). A
 * site without them is the page as it always was, the language switch in
 * the corner.
 */
const { Look, Header, Footer } = FRAME;
// The page's language, from its address: `/de/…` is German. The copy is that
// language's where the site has registered it (src/copy/index.ts); `lang`
// is the page's whatever the copy says.
const locale = localeOf(Astro.url.pathname);
const COPY = copyFor(locale);
const META = { ...COPY.META, lang: langOf(locale) };

/*
 * The business's facts: what the owner keeps in the panel's contacts — the
 * shared text's fields that say a `role` (contract 3, wiki/98 §4.5) — read
 * through the door in this page's language, and src/data/site.ts only where
 * a role is empty. Read from the constant alone, the site went on naming the
 * business by `jtk create --name`, with no address and no telephone, while
 * the contacts the owner had filled in said otherwise (the contract-3
 * rehearsal, 11 November 2026). Contract 2 says no roles: every fact is
 * src/data/site.ts's, as it always was.
 */
const facts = site.facts(locale);
const fact = (role: string, own: string): string => facts.text(role).trim() || own;
const NAME = fact('name', BUSINESS.name);
const CITY = fact('city', BUSINESS.city);

const canonical = canonicalFor(Astro.url.pathname);
// `under` and not a leading slash: `new URL('/og.jpg', …)` throws away the
// path this build is served under, which under the studio's preview is the
// whole of the site's address. src/lib/under.ts has the argument.
const ogImage = new URL(under('/og.jpg'), Astro.site).href;
// Never an empty <title> (WCAG 2.4.2): a page whose own title nobody has
// written yet is named after the business, which is what a visitor would
// call it anyway (12 October 2026: the home page of a fresh site had none).
const named = title.trim() || NAME || '';
// The suffix names the business as its shared text does (contract 3's
// contacts, by role) — the name og:site_name and the structured data say —
// and the copy's suffix, written at `jtk create`, only where the shared text
// names nobody (contract 2, or contacts not filled yet).
const ownName = facts.text('name').trim();
const fullTitle = suffix && title.trim() ? `${named}${ownName !== '' ? ` — ${ownName}` : META.titleSuffix}` : named;

/**
 * One business, described once, on every page. The `@id` is stable across the
 * site so the pages describe the same entity rather than a dozen similar ones.
 *
 * Only confirmed fields are emitted: an empty value is dropped rather than
 * asserted as an empty string. geo and openingHours are absent on purpose until
 * the client confirms them — see src/data/site.ts.
 */
const social = facts.rows('social').map((row) => row.text('url').trim()).filter(Boolean);
const sameAs = social.length > 0 ? social : [BUSINESS.instagram, BUSINESS.facebook].filter(Boolean);

/**
 * The palette, as CSS custom properties on :root.
 *
 * Written here rather than into a stylesheet so that it stays a *document* —
 * `jtk/design.json`, beside the content — and can therefore be changed
 * without rebuilding anybody's opinion into a file. `HeroField` reads its
 * colours as custom properties and watches the root element for changes, which
 * is also how the studio bar's live accent picker drives a variant.
 *
 * Empty values are left out entirely, so a scaffold nobody has designed keeps
 * the kit's own tokens instead of inheriting a page of blanks.
 */
const palette: Record<string, string> = {};

/*
 * Which way up the page is.
 *
 * A photograph's shadows are dark on any page — but `--ink` and `--paper` swap
 * over on a dark one, so the treatment tokens derived from them come out
 * inverted and `duotone` folds a photograph into a flat rectangle. It looked
 * like a broken blend mode and it was a palette read upside down.
 *
 * The document has both colours as literals, so the page can be asked rather
 * than assumed. No palette chosen yet means the kit's own light tokens, which
 * is what global.css already declares.
 */
const luminance = (hex: string): number | null => {
  const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
  if (!m) return null;
  const n = parseInt(m[1], 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255]
    .map((v) => {
      const c = v / 255;
      return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
    })
    .reduce((sum, c, i) => sum + c * [0.2126, 0.7152, 0.0722][i], 0);
};

/*
 * The palette (docs/looks.md, «The palette»): one object in jtk/design.json,
 * eight colours by name — what an agent writes once, and what a palette widget's
 * «Use this palette» hands it — read here and nowhere else:
 *
 *   background     the page                       → --paper
 *   surface        a card, the form, the header   → --panel, --paper-lift
 *   ink            the words                      → --ink
 *   muted          the quieter words              → --ink-quiet
 *   accent         the button, the one colour     → --accent (the words on it chosen by its lightness)
 *   accent-ink     the accent as words on the page → --accent-ink, --accent-deep
 *   lacquer        the hero's polish, in shadow   → --lacquer
 *   lacquer-light  the same polish, lit           → --lacquer-light
 *
 * A six-digit hex each; an empty one keeps the look's own token. It wins over
 * the older `paper`, `ink` and `accent` beside it, which it replaces.
 */
const SAID = ((DESIGN as { palette?: Record<string, unknown> }).palette ?? {}) as Record<string, unknown>;
const hexOf = (value: unknown): string => (typeof value === 'string' && /^#[0-9a-f]{6}$/i.test(value.trim()) ? value.trim() : '');
const PALETTE = {
  background: hexOf(SAID.background) || DESIGN.paper || '',
  surface: hexOf(SAID.surface),
  ink: hexOf(SAID.ink) || DESIGN.ink || '',
  muted: hexOf(SAID.muted),
  accent: hexOf(SAID.accent) || DESIGN.accent || '',
  accentInk: hexOf(SAID['accent-ink']),
  lacquer: hexOf(SAID.lacquer),
  lacquerLight: hexOf(SAID['lacquer-light']),
};

const paperLuma = PALETTE.background ? luminance(PALETTE.background) : null;
const inkLuma = PALETTE.ink ? luminance(PALETTE.ink) : null;
const invertedPage = paperLuma !== null && inkLuma !== null && paperLuma < inkLuma;

/*
 * Only the three the document decides, and which way «lifted» is.
 *
 * `--panel` and `--accent-ink` were set here to the paper and the accent
 * themselves, and an inline style on <html> beats `:root` — so the lifted
 * surface and the darker text form global.css derives were flattened back, and
 * the accent carried words at 3.4:1 (an agent's rehearsal, 30 September 2026).
 * They are derived in global.css from these three, which is also what lets the
 * studio bar's live accent move all of them at once. What CSS cannot tell is
 * whether the page is light or dark, so `--lift` says which way a panel rises:
 * towards white on a light page, towards the ink on a dark one.
 */
if (PALETTE.background) palette['--paper'] = PALETTE.background;
if (PALETTE.background) palette['--lift'] = invertedPage ? 'var(--ink)' : '#ffffff';
/*
 * And which way «recessed» goes. `--paper-deep` is a light grey in global.css,
 * right below white and a pale band under a dark page's light words — an FAQ
 * read 1.03:1 (12 October 2026). On a dark page it is the paper a step
 * darker.
 */
// A light page keeps global.css's grey, which is what every site has drawn.
if (PALETTE.background && invertedPage) palette['--paper-deep'] = 'color-mix(in srgb, var(--paper) 82%, #000000)';
if (PALETTE.ink) palette['--ink'] = PALETTE.ink;
if (PALETTE.accent) palette['--accent'] = PALETTE.accent;
/*
 * The words a button carries on the accent, by the accent's own lightness:
 * near-black on a light accent, white on a dark one — whichever reads further
 * from it (WCAG 1.4.3). The two meet at a luminance of 0.195. It was white
 * whatever the accent, and white on a dark page's amber read 1.98:1
 * (12 October 2026). A variant may still set --on-accent itself.
 */
const accentLuma = PALETTE.accent ? luminance(PALETTE.accent) : null;
if (accentLuma !== null) palette['--on-accent'] = accentLuma > 0.195 ? '#16130f' : '#ffffff';
/*
 * The rest of the palette, where it is said: a look's tokens are named the
 * same in every look (docs/looks.md), so these reach every component. A
 * palette that names its background gets its lines and its recessed ground
 * from it too, rather than a look's fixed grey that was drawn for another
 * paper.
 */
if (PALETTE.surface) {
  palette['--panel'] = PALETTE.surface;
  palette['--paper-lift'] = PALETTE.surface;
  palette['--surface'] = PALETTE.surface;
}
if (PALETTE.muted) palette['--ink-quiet'] = PALETTE.muted;
if (PALETTE.accentInk) {
  palette['--accent-ink'] = PALETTE.accentInk;
  palette['--accent-deep'] = PALETTE.accentInk;
  // A control filled with it (the booking form's steps) carries words too: by its lightness, as on the accent.
  palette['--on-accent-deep'] = (luminance(PALETTE.accentInk) ?? 0) > 0.195 ? '#16130f' : '#ffffff';
}
if (PALETTE.accent) {
  const n = parseInt(PALETTE.accent.slice(1), 16);
  palette['--glow'] = `${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255}`;
}
if (PALETTE.lacquer) palette['--lacquer'] = PALETTE.lacquer;
if (PALETTE.lacquerLight) palette['--lacquer-light'] = PALETTE.lacquerLight;
if (hexOf(SAID.background)) {
  palette['--line'] = 'color-mix(in srgb, var(--ink) 13%, var(--paper))';
  if (!invertedPage) palette['--paper-deep'] = 'color-mix(in srgb, var(--paper) 94%, var(--ink))';
}
if (DESIGN.ground) palette['--jtk-ground'] = DESIGN.ground;
(DESIGN.colors ?? []).forEach((colour: string, i: number) => {
  if (colour) palette[`--jtk-c${i + 1}`] = colour;
});

/*
 * On a dark page the two ends of a photograph's tonal range take the same two
 * tokens the other way round: the page's ground is what its shadows are tinted
 * with, and the ink is what its highlights are. A variant can still override
 * either — this only stops the default from being wrong.
 */
if (invertedPage) {
  palette['--photo-shadow'] = 'color-mix(in srgb, var(--paper) 78%, var(--accent))';
  palette['--photo-light'] = 'var(--ink)';
}

const rootStyle = Object.entries(palette)
  .map(([name, value]) => `${name}:${value}`)
  .join(';');

// The telephone as it is dialled: the contacts' one number, as the owner
// typed it, or the E.164 form src/data/site.ts keeps beside the display one.
const telephone = fact('phone', BUSINESS.phoneDial);
const email = fact('email', BUSINESS.email);
const priceRange = fact('price_range', BUSINESS.priceRange);
const hasMap = fact('maps', BUSINESS.mapsUrl);
const address = Object.fromEntries(
  Object.entries({
    streetAddress: fact('street', BUSINESS.street),
    postalCode: fact('postal_code', BUSINESS.postalCode),
    addressLocality: CITY,
    addressRegion: fact('region', BUSINESS.region),
    addressCountry: fact('country', BUSINESS.country),
  }).filter(([, value]) => value !== ''),
);

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': fact('business_type', SCHEMA_TYPE),
  '@id': `${canonicalFor('/')}#business`,
  name: NAME,
  description: BUSINESS.description || description,
  url: canonicalFor('/'),
  image: ogImage,
  inLanguage: META.lang,
  ...(telephone ? { telephone } : {}),
  ...(email ? { email } : {}),
  ...(priceRange ? { priceRange } : {}),
  ...(hasMap ? { hasMap } : {}),
  ...(sameAs.length ? { sameAs } : {}),
  ...(CITY ? { address: { '@type': 'PostalAddress', ...address } } : {}),
};
---

<!doctype html>
<html lang={META.lang} style={rootStyle || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/*
      The other languages of this page.
      
      `x-default` is the site's own language: it is what a search engine shows
      somebody whose language is none of these, and leaving it out means the
      engine picks for itself. The locale of the site's own pages is empty in
      the content, and here it becomes the site's own tag (`langOf`), never
      this page's: on /en/ the original's alternate said `en`, so the page
      named two English alternates (the two-language rehearsal on staging, 12
      November 2026).
    */}
    {alternates.map((other) => (
      <link
        rel="alternate"
        hreflang={langOf(other.locale)}
        href={canonicalFor(other.address)}
      />
    ))}
    {alternates.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={canonicalFor(alternates.find((one) => one.locale === '')?.address ?? '/')} />
    )}

    {/* One flag drives this, robots.txt, the sitemap and llms.txt together. */}
    <meta
      name="robots"
      content={INDEXABLE ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'}
    />

    {/* Search Console ownership, when the site has one. Independent of robots —
        Google fetches the page directly to verify, so noindex does not block it. */}
    {/* <meta name="google-site-verification" content="" /> */}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content={META.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={NAME} />
    <meta name="twitter:card" content="summary_large_image" />

    {CITY && <meta name="geo.placename" content={CITY} />}

    {/* iOS turns any number that looks like one into a call link — including
        prices and dates. The real phone numbers are explicit tel: links. */}
    <meta name="format-detection" content="telephone=no" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* Under the base, like every other address written by hand here: served
        from `/p/<slug>/` these are three 404s and a page with no icon. */}
    {/* The icon: one source, the PNGs rendered from it (src/lib/icon.ts). */}
    {!RASTER_MARK && <link rel="icon" href={under('/favicon.svg')} type="image/svg+xml" />}
    <link rel="icon" href={under('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={under('/apple-touch-icon.png')} />

    {/*
      Marks the document as scripted before first paint, so every hidden start
      state can hang on `html.js` and a visitor without JavaScript is never left
      staring at opacity: 0. Wrapped in nothing on purpose — it cannot throw.
    */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/*
      The height of the screen, measured once before the first paint and
      held, as `--screen` (global.css, docs/kit.md «The floor»).

      Every height on the page measured against the screen reads this and
      not a viewport unit. The browsers inside Telegram, Instagram and
      WhatsApp slide their bar away under a scrolling thumb and back, and
      every vh, svh and dvh follows it: the hero and every band sized by the
      screen squeezed and stretched while the page only scrolled
      (wohlfühl-Raum and Rail-tec, which hold it this way; wiki/115 F1). So
      it changes only when the width does — a turned phone, a window made
      wider — and never with the bar or the keyboard. Without scripts the
      declaration's own value, 100svh, is right everywhere it is honoured.
    */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var was = 0;
        var hold = function () {
          if (window.innerWidth === was) return;
          was = window.innerWidth;
          root.style.setProperty('--screen', window.innerHeight + 'px');
        };
        hold();
        addEventListener('resize', hold, { passive: true });
        addEventListener('orientationchange', function () {
          was = 0;
          setTimeout(hold, 120);
        });
      })();
    </script>
    {Look && <Look />}
  </head>

  <body class={bodyClass}>
    {/*
      The first stop of the keyboard, straight to what the page is about
      (WCAG 2.4.1): every page puts its content in <main id="content">. Out of
      sight until it is focused, then the first thing on the screen. The words
      were in the copy since the scaffold had a copy, and nothing drew them
      (12 October 2026).
    */}
    <a class="skip-link" href="#content" data-jtk-fixed lang={COPY.WORDS_LANG || undefined}>{COPY.A11Y.skipToContent}</a>
    {Header && <Header languages={languages} locale={locale} />}
    <slot />
    {Footer && <Footer locale={locale} />}
    {/* The switcher, drawn only on a page that exists in more than one
        language. Here so a second language works the day it is declared;
        move it into the header when the design has one — the example's
        header has it. */}
    {!Header && <Languages alternates={languages} current={locale} class="languages--corner" />}

    <script>
      /*
       * What turns an entrance on.
       *
       * The hidden start states in surface.css all hang on `html.js`, which is
       * set before first paint above; this adds `.is-in` when the block reaches
       * the screen, and then stops watching it. A block never re-enters: an
       * animation that replays on the way back up is the thing clients report
       * as "it keeps flashing".
       *
       * `data-edge="trace"` is watched by the same observer for the same
       * reason — a border that draws itself is an entrance wearing a different
       * name.
       *
       * With no IntersectionObserver everything is simply in. The page is not
       * missing anything; it is the page without the entrance.
       */
      const targets = document.querySelectorAll<HTMLElement>(
        '[data-reveal]:not([data-reveal="none"]), [data-edge="trace"]',
      );

      /* The stagger's index, set here rather than written into the markup: a
         list rendered from a document has nowhere to carry one, and the second
         list is where somebody forgets. */
      const order = (el: HTMLElement) => {
        if (el.dataset.reveal !== 'stagger') return;
        [...el.children].forEach((child, i) =>
          (child as HTMLElement).style.setProperty('--i', String(i)),
        );
      };

      /* `float` starts at rest and is armed only where it is out of sight below
         the screen (surface.css), never under reduced motion. */
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const seen = new WeakSet<Element>();

      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => {
          order(el);
          el.classList.add('is-in');
        });
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const first = !seen.has(entry.target);
              seen.add(entry.target);
              if (!entry.isIntersecting) {
                if (first && !still && (entry.target as HTMLElement).dataset.reveal === 'float' && entry.boundingClientRect.top > 0) {
                  entry.target.classList.add('is-armed');
                }
                continue;
              }
              order(entry.target as HTMLElement);
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          },
          /* Slightly inside the fold, so a block animates as it is arrived at
             rather than a moment before. */
          { rootMargin: '0px 0px -10% 0px' },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
    {/*
      Where a link in the page lands (the floor's F9, the platform's design
      guide): the section's first words just under a header that stays, not
      the section's top padding under it. A tap on «Angebot» in the
      wohlfühl-Raum's header landed 100–170 px of empty padding above the
      heading, and the visitor scrolled again (20 November 2026). Each
      section's offset is the header's height and a little air, less its own
      top padding — measured, since both are the design's — and measured
      again as the link is tapped, the header having gathered by then. A
      target that sets its own offset says `data-land="own"`.
    */}
    <script is:inline>
      (function () {
        var stays = function () {
          var all = document.querySelectorAll('[data-header], body > header, header');
          for (var i = 0; i < all.length; i++) {
            var p = getComputedStyle(all[i]).position;
            if (p === 'sticky' || p === 'fixed') return all[i];
          }
          return null;
        };
        var land = function (target) {
          if (!target || target.matches('main, body') || target.getAttribute('data-land') === 'own') return;
          var header = stays();
          var top = header ? header.getBoundingClientRect().height : 0;
          var air = (parseFloat(getComputedStyle(document.documentElement).fontSize) || 16) * 1.5;
          var pad = parseFloat(getComputedStyle(target).paddingTop) || 0;
          target.style.scrollMarginBlockStart = Math.round(top + air - pad) + 'px';
        };
        var every = function () {
          document.querySelectorAll('section[id], [data-jtk-block][id]').forEach(land);
        };
        every();
        addEventListener('resize', every, { passive: true });
        document.addEventListener('click', function (event) {
          var link = event.target instanceof Element ? event.target.closest('a[href*="#"]') : null;
          if (!link) return;
          var url = new URL(link.href, location.href);
          if (url.pathname !== location.pathname || url.hash.length < 2) return;
          try { land(document.getElementById(decodeURIComponent(url.hash.slice(1)))); } catch (_) {}
        }, true);
        // Arrived from another page with a hash: the browser jumped before the
        // offsets were set, so land again once the page is laid out.
        if (location.hash.length > 1) {
          addEventListener('load', function () {
            try {
              var target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
              if (target) { land(target); target.scrollIntoView({ block: 'start' }); }
            } catch (_) {}
          });
        }
      })();
    </script>
  </body>
</html>
