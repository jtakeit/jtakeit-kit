---
/**
 * One entry of one collection — a blog post, a work, a job.
 *
 * ── one file for every collection, and why it is a starting point ───────────
 *
 * This route generates every entry of every collection the site declares, so a
 * new collection is an entry in `COLLECTIONS` and its listing page, and never a
 * second copy of this file. What it renders is deliberately plain: a heading, a
 * picture where there is one, and the body. Exactly like `Blocks.astro`, it is
 * the thing that makes a site buildable on the first commit, not the design.
 *
 * **The design pass replaces what is inside `<article>`. What must survive it
 * is the annotation.** Every field the owner may edit carries its
 * `data-jtk-path`, `jtkit lint` fails the build without one, and an
 * element that loses its path stops opening the editor *silently*.
 *
 * The entry is the kit's door's (`site` in src/lib/site.ts), and so is every
 * annotation on it: `entry.fields` are its own values — its title, its date,
 * its cover and its prose — and `entry.body` the blocks below them, each value
 * read with `text`, `value`, `rows`, `picture`, `gallery`, and annotated with
 * `{...at(field)}`. Nothing here writes a path: the door writes the one the
 * platform reads, and the same template reads the next contract unchanged.
 *
 * ── a hidden entry is built ─────────────────────────────────────────────────
 *
 * `getStaticPaths` asks for every entry — `{ all: true }` — and not only the
 * ones that are out. That is on purpose: an entry nobody has finished still
 * has to be looked at before it is finished, and the studio's edge serves
 * such a page only to a session that is editing the site. Every place that
 * *lists* entries asks for the ones that are out, and this one renders.
 *
 * ── what points here, and where it sits ─────────────────────────────────────
 *
 * An entry's page is also its archive: below the post, the entries of the other collections that point at
 * it — a category's services, a tag's posts — under each collection's name,
 * in its order, linked to their pages; for a category in a tree, what points
 * at the categories under it as well, each once. And where the collection is a tree
 * (`parent: ref categories`), the trail of its parents above the title and its
 * children below. `site.referrersOf` and `site.treeOf` read them; the titles
 * carry the entry's own annotation as drawn elsewhere, as a listing's do.
 *
 * ── the specimens ───────────────────────────────────────────────────────────
 *
 * One page per arrangement of every type a post may hold, in every language,
 * built here inside the same article as every other post and listed nowhere
 * (`site.specimens`): the panel lifts this site's own markup from them for a
 * block an owner has just added, in the post's language.
 */
import { bodyOf, linksToListing, listingHref, href, titleOf, type Collection, type Entry } from '../lib/entries';
import type { Field } from '@jtakeit/kit/content';
import { copyFor } from '../copy';
import { site } from '../lib/site';
import { langOf } from '../lib/locale';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { isUpload, uploaded } from '../lib/uploads';
import { photo } from '../lib/photos';

export async function getStaticPaths() {
  const paths = [];

  for (const collection of site.collections) {
    // A collection without pages — a price list, the tables of a restaurant —
    // has none: its entries are rows of its listing (`[...listing].astro`),
    // and the platform expects no route for them.
    if (!collection.pages) continue;
    for (const locale of site.locales) {
      for (const entry of [...site.entries(collection.name, { locale, all: true }), ...site.specimens(collection.name, { locale })]) {
        // `de/blog/healing` for an entry written in German (docs/languages.md).
        paths.push({ params: { entry: entry.address!.slice(1) }, props: { entry, collection } });
      }
    }
  }
  return paths;
}

const { entry: listed, collection } = Astro.props as { entry: Entry; collection: Collection };
/** The entry on its own page: annotated as the page's own document. */
const entry = listed.here;
const { fields } = entry;
/** The entry's language: `''` for the site's own, `'de'` for one in German. */
const locale = entry.locale;
const LANG = langOf(locale);
const { LISTING } = copyFor(locale);
const alternates = site.alternatesOf(entry);

/*
 * Whether this entry's type has a body at all. A post has; a car, a doctor, an
 * apartment has not — its page is its fields — and a body drawn for one was an
 * editable place the catalogue does not declare: the admin would open an
 * editor on nothing, and `jtk catalogue` said so for every car of a rental
 * (30 September 2026).
 */
const hasBody = collection.fields.some((field) => field.key === 'body');
const { Content, texts } = await bodyOf(entry);

const title = fields.text('title');
const excerpt = fields.text('excerpt');
const coverPicture = fields.picture('cover');
const cover = coverPicture.src !== ''
  ? (isUpload(coverPicture.src) ? uploaded(coverPicture.src) : photo(coverPicture.src))
  : undefined;

/*
 * ── every field the catalogue declares, not three ───────────────────────────
 *
 * The heading, the cover and the body are drawn by hand above; everything else
 * the entry's type declares is drawn here, in the catalogue's order. A room
 * type's price, an apartment's guests, a master's hours: an entry's page is
 * its fields, and a field the owner fills in that no page shows is a field
 * the guest never reads. A hotel's room type with a price refused every build
 * (JTK_E_UNANNOTATED_FIELD …: blocks[0].costs, the night run of 2 October
 * 2026), and the fields the check does not look for — a number, a list — were
 * dropped from the page without a word.
 *
 * A field the owner edits by tapping it carries its `data-jtk-path`, by the
 * same rule `jtkit lint` checks; the rest are edited in the panel
 * beside the page and are drawn plain.
 */
const DRAWN = new Set(['title', 'cover', 'body']);

/** A length as the trade says it: whole days, whole hours, or minutes. */
function length(minutes: number): string {
  const [unit, n] = minutes % 1440 === 0 ? ['day', minutes / 1440] : minutes % 60 === 0 ? ['hour', minutes / 60] : ['minute', minutes];
  return new Intl.NumberFormat(LANG, { style: 'unit', unit, unitDisplay: 'long' }).format(n);
}

// In the site's currency, as the platform writes it — never a page's own.
const money = (value: unknown): string => site.money(value, locale);

/** 540 is 09:00. */
function clock(minutes: number): string {
  return `${String(Math.floor(minutes / 60) % 24).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;
}

/** monday … sunday in the site's language: 1 January 2024 was a Monday. */
const WEEK = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
function weekday(day: string): string {
  const at = WEEK.indexOf(day);
  return at < 0 ? day : new Intl.DateTimeFormat(LANG, { weekday: 'long', timeZone: 'UTC' }).format(new Date(Date.UTC(2024, 0, 1 + at)));
}

/*
 * The titles a slug stands for: a `ref` names its collection, and a
 * resource's `does` names services of the diary's own.
 */
const titles = new Map<string, Map<string, string>>();
const addresses = new Map<string, Map<string, string>>();
function titlesOf(name: string | undefined): Map<string, string> {
  const target = name === undefined ? undefined : site.collection(name);
  if (name === undefined || target === undefined) return new Map();
  if (!titles.has(name)) {
    const all = site.entries(name, { locale });
    // A title in the site's own language stands in for one not translated
    // yet — a German post's tag reads «Rot» once somebody writes it, and «Red»
    // until then rather than its slug — as a group's heading does.
    const own = locale === '' ? [] : site.entries(name, { locale: '' });
    titles.set(name, new Map([...own, ...all].map((one) => [one.slug, String(one.fields.value('title') ?? one.slug)])));
    // Where each has a page, for a ref to be a link: a post's tags lead to
    // the tags' pages, which list the posts (12 October 2026).
    addresses.set(name, new Map(target.pages ? all.map((one) => [one.slug, href(one)]) : []));
  }
  return titles.get(name)!;
}

/** The page a ref's value has, where its collection gives entries pages and the entry is listed. */
function linkOf(field: Field, value: unknown): string | undefined {
  if (field.kind !== 'ref' || typeof value !== 'string') return undefined;
  titlesOf(field.ref);
  return addresses.get(field.ref ?? '')?.get(value);
}

/** One value as words, for a field that is drawn plain. */
function spoken(field: Field, value: unknown): string {
  if (value === undefined || value === null || value === '') return '';
  switch (field.kind) {
    case 'money': return money(value);
    case 'duration': return length(Number(value));
    case 'time_of_day': return clock(Number(value));
    case 'date': {
      const day = new Date(String(value));
      return Number.isNaN(day.getTime()) ? String(value) : new Intl.DateTimeFormat(LANG, { dateStyle: 'long', timeZone: 'UTC' }).format(day);
    }
    case 'select': {
      const label = field.option_labels?.[String(value)];
      if (label !== undefined) return site.words(label, LANG);
      return WEEK.includes(String(value)) ? weekday(String(value)) : String(value);
    }
    case 'bool': return value === true ? site.words(field.label, LANG) : '';
    case 'ref': return titlesOf(field.ref).get(String(value)) ?? String(value);
    case 'list': return '';
    default: {
      const services = site.rolesOf('bookings')?.services;
      if (field.key === 'service' && services) return titlesOf(services).get(String(value)) ?? String(value);
      return String(value);
    }
  }
}

/** A row of a list as one line: a week's row is «понеділок 09:00–18:00». */
function rowSaid(of: Field[], row: { value(key: string): unknown }): string {
  const keys = new Set(of.map((one) => one.key));
  if (keys.has('opens') && keys.has('closes')) {
    const day = of.find((one) => one.key === 'day');
    const when = `${clock(Number(row.value('opens')))}–${clock(Number(row.value('closes')))}`;
    return day ? `${spoken(day, row.value('day'))} ${when}` : when;
  }
  const parts: string[] = [];
  for (const one of of) {
    const part = spoken(one, row.value(one.key));
    if (part !== '') parts.push(part);
  }
  return parts.join(' · ');
}

type At = { 'data-jtk-path'?: string };
type Picture = { file: ImageMetadata; alt: string; at: At };
type Fact =
  | { key: string; label: string; kind: 'pictures'; pictures: Picture[] }
  | { key: string; label: string; kind: 'picture'; file: ImageMetadata; alt: string; at: At }
  | { key: string; label: string; kind: 'text'; text: string; at: At; tappable: boolean; href?: string }
  | { key: string; label: string; kind: 'rows'; rows: { text: string; href?: string }[] };

/** A picture's file: a key in the studio's bucket the build downloaded, or a photograph this repository ships. */
const fileOf = (src: string): ImageMetadata | undefined => (isUpload(src) ? uploaded(src) : photo(src));

const facts: Fact[] = [];
for (const field of collection.fields) {
  if (DRAWN.has(field.key)) continue;
  const value = fields.value(field.key);
  if (value === undefined) continue;
  const label = site.words(field.label, LANG);

  if (field.kind === 'media') {
    if (field.multiple) {
      // Each picture annotated by its place in the field it was read from.
      const pictures: Picture[] = fields.gallery(field.key).flatMap((one) => {
        const file = fileOf(one.src);
        return file === undefined ? [] : [{ file, alt: one.alt, at: { 'data-jtk-path': one['data-jtk-path'] } }];
      });
      if (pictures.length > 0) facts.push({ key: field.key, label, kind: 'pictures', pictures });
      continue;
    }
    const picture = fields.picture(field.key);
    const file = fileOf(picture.src);
    if (file !== undefined) facts.push({ key: field.key, label, kind: 'picture', file, alt: picture.alt, at: fields.at(field.key) });
    continue;
  }
  if (field.kind === 'list') {
    const rows: { text: string; href?: string }[] = [];
    // A row that is one ref — a post's tags, `list of { tag: ref tags }` —
    // links to that entry's page, the way a single ref does.
    const only = field.of?.length === 1 ? field.of[0] : undefined;
    for (const row of fields.rows(field.key)) {
      const line = rowSaid(field.of ?? [], row);
      if (line !== '') rows.push({ text: line, href: only ? linkOf(only, row.value(only.key)) : undefined });
    }
    if (rows.length > 0) facts.push({ key: field.key, label, kind: 'rows', rows });
    continue;
  }
  const text = spoken(field, value);
  if (text === '') continue;
  const link = field.kind === 'url' ? String(value) : field.kind === 'email' ? `mailto:${value}` : field.kind === 'tel' ? `tel:${String(value).replace(/[^+\d]/g, '')}` : linkOf(field, value);
  // A field the owner edits by tapping it carries its annotation, by the
  // platform's one rule (`tappable`, the door's); the rest are edited in the
  // panel beside the page and are drawn plain.
  const tappable = fields.tappable(field.key);
  facts.push({ key: field.key, label, kind: 'text', text, href: link, at: tappable ? fields.at(field.key) : {}, tappable });
}

/**
 * The entry as a thing search engines and assistants can quote.
 *
 * `datePublished` is the field the catalogue reserves, which is why it may be
 * read by name here: the five keys of an entry are the admin's vocabulary and
 * not a site's to rename.
 */
/**
 * What a search result says, where somebody wrote it.
 *
 * The admin has a card for these two — the title in a result list and the
 * sentence under it — and they appear nowhere on the page, which is exactly why
 * they are edited in a form rather than by tapping. Empty, a post is found by
 * its own heading and its announcement, so this is a fallback and never a
 * second pair of fields that must be filled in.
 */
const seo = entry.seo;
const said = (key: string): string =>
  typeof seo[key] === 'string' ? (seo[key] as string).trim() : '';

/*
 * The archive: what points here from the other collections, and this entry's
 * place in its own collection's tree. A row's address is its page, or its row
 * on the listing for a collection without pages (`[...listing].astro` gives
 * each row an id for that) — `href` in lib/entries says which.
 */
const referrers = site.referrersOf(entry);
const tree = site.treeOf(entry);
const archive = [
  ...(tree.children.length > 0 ? [{ collection, entries: tree.children, more: tree.more }] : []),
  ...referrers,
];

const date = fields.value('date');
const schema = {
  '@type': 'Article',
  headline: title,
  datePublished: typeof date === 'string' ? date : undefined,
  description: excerpt || undefined,
};
---

<Layout title={said('title') || title} description={said('description') || excerpt} schema={schema} alternates={alternates}>
  <main id="content">
    <article class="entry">
      {
        tree.trail.length > 0 && (
          <nav class="entry-trail">
            <ol>
              {tree.trail.map((one) => {
                const crumb = titleOf(one);
                return <li><a href={href(one)} {...crumb.at} data-jtk-fixed={crumb.fixed ? true : undefined}>{crumb.text}</a></li>;
              })}
            </ol>
          </nav>
        )
      }
      <h1 {...fields.at('title')}>{title}</h1>

      {
        cover && (
          <Image
            src={cover}
            alt={coverPicture.alt}
            data-jtk-path={coverPicture['data-jtk-path']}
            widths={[640, 1280, 1920]}
            sizes="(min-width: 900px) 60rem, 92vw"
            layout="none"
          />
        )
      }

      {
        facts.length > 0 && (
          <dl class="entry-facts">
            {facts.map((fact) => (
              <div class="entry-fact" data-field={fact.key}>
                {/* The label is the catalogue's; a value with no path is edited in
                    the panel beside the page, not by tapping — both are said fixed,
                    so the check does not read them as words the owner cannot reach. */}
                <dt data-jtk-fixed>{fact.label}</dt>
                {fact.kind === 'text' && (
                  <dd {...fact.at} data-jtk-fixed={fact.tappable ? undefined : true}>{fact.href ? <a href={fact.href}>{fact.text}</a> : fact.text}</dd>
                )}
                {fact.kind === 'rows' && (
                  <dd data-jtk-fixed><ul>{fact.rows.map((row) => <li>{row.href ? <a href={row.href}>{row.text}</a> : row.text}</li>)}</ul></dd>
                )}
                {fact.kind === 'picture' && (
                  <dd>
                    <Image src={fact.file} alt={fact.alt} data-jtk-path={fact.at['data-jtk-path']} widths={[640, 1280]} sizes="(min-width: 900px) 30rem, 92vw" layout="none" />
                  </dd>
                )}
                {fact.kind === 'pictures' && (
                  <dd class="entry-wall">
                    {fact.pictures.map((one) => (
                      <Image src={one.file} alt={one.alt} data-jtk-path={one.at['data-jtk-path']} widths={[640, 1280]} sizes="(min-width: 900px) 30rem, 92vw" layout="none" />
                    ))}
                  </dd>
                )}
              </div>
            ))}
          </dl>
        )
      }

      {/*
        One element for the whole body, because the body is one field. The
        editor opens it full screen — nine hundred words is not a popover — and
        what is inside is markdown Astro rendered, pictures and all.
      */}
      {hasBody && <div class="entry-body" {...fields.at('body')}><Content /></div>}

      {/*
        And the rest of the post, in the order the owner put it in.

        A post is a *sequence*: its opening prose above, then runs of prose and
        whatever else it holds, interleaved. A post is written rather than
        designed, so the owner arranges these in the admin — but *which* types
        may be in one is this repository's to say, in `COLLECTIONS[].body`, and
        `text` must be among them or the writing cannot be broken by anything.

        A gallery arrives with the arrangement it is in — `block.view`, always
        one of the ones its type declares. Draw each one differently: that menu
        is the whole reason the owner may choose, and a `view` that changes
        nothing on the page is a choice this repository lied about offering.

        Plain on purpose, exactly like `Blocks.astro`: what the design pass
        replaces is what is inside, and what must survive it is the
        `data-jtk-path` on every field the owner may edit.
      */}
      {
        entry.body.map((block, at) => {
          /*
           * A run of prose. A post is a sequence — prose, a gallery, more
           * prose — and this is what the runs after the first are. Rendered by
           * the loader, because Astro renders one body per entry and knows
           * nothing about a second.
           */
          if (block.type === 'text') {
            return (
              <div
                class="entry-body"
                {...block.at('body')}
                set:html={texts[at] ?? ''}
              />
            );
          }

          /*
           * A gallery: the pictures of the field its type declares as one, each
           * annotated by its place in that field — whatever the field is
           * called. It used to read `work` or `items` by name and annotate
           * every picture as `work` (wiki/98 §0).
           */
          const field = site.type(block.type)?.fields.find((one) => one.kind === 'media' && one.multiple === true);
          const pictures = field === undefined ? [] : block.gallery(field.key);

          return (
            <div class="entry-wall" data-view={block.view ?? ''}>
              {pictures.map((picture) => {
                /*
                 * The same two answers the cover has, for the same reason: a
                 * value is either a key in the studio's bucket, which the build
                 * downloaded, or the name of a photograph this repository
                 * ships. Reading only the first renders nothing at all for the
                 * second, with no error until the build refuses the undefined.
                 */
                const file = fileOf(picture.src);
                if (!file) return null;

                return (
                <Image
                  src={file}
                  alt={picture.alt}
                  data-jtk-path={picture['data-jtk-path']}
                  widths={[640, 1280]}
                  sizes="(min-width: 900px) 30rem, 92vw"
                  layout="none"
                />
                );
              })}
            </div>
          );
        })
      }
    </article>

    {/*
      What points here, under each collection's name — the catalogue's, so
      fixed — and each entry by its own title, annotated as that entry's
      field. A collection with more than its `per_page` shows that many and
      says how many more in the page's language («And 3 more», `LISTING` in
      src/copy) — linked to that collection's listing where it has one by
      the rule (`linksToListing`: no pages of its own, or `listing: true`),
      words otherwise.
    */}
    {
      archive.map((one) => (
        <section class="entry-refs" data-collection={one.collection.name}>
          <h2 data-jtk-fixed>{site.words(one.collection.label, LANG)}</h2>
          <ul>
            {one.entries.map((row) => {
              const named = titleOf(row);
              return (
              <li>
                <a href={href(row)} {...named.at} data-jtk-fixed={named.fixed ? true : undefined}>{named.text}</a>
              </li>
              );
            })}
          </ul>
          {one.more > 0 && (
            linksToListing(one.collection)
              ? <p class="entry-refs-more" data-jtk-fixed><a href={listingHref(one.collection.name, locale)}>{LISTING.more(one.more)}</a></p>
              : <p class="entry-refs-more" data-jtk-fixed>{LISTING.more(one.more)}</p>
          )}
        </section>
      ))
    }
  </main>
</Layout>
