---
/**
 * The listing of a collection without pages — and, for the diary's services,
 * the page a visitor books on — and page one of a collection's with pages.
 *
 * ── a collection with pages ─────────────────────────────────────────────────
 *
 * Listed at its prefix too when it asks — `listing: true`, never by default
 * (`drawsPagedListing` in the kit's door says why) — as tiles linked to the entries' pages and
 * `per_page` of them to a page: `EntryListing.astro` draws it, here for page
 * one and in `[...listing]/page/[page].astro` for the rest, and lib/entries
 * says why page two is `<prefix>/page/2`. Not where the repository wrote its
 * own listing at that prefix (the blog's `[...lang]/blog/index.astro`), which
 * then has the address to itself.
 *
 * Everything below is about a collection without pages.
 *
 * ── why every such collection has one ───────────────────────────────────────
 *
 * An entry of a collection with `pages: false` — a rate, a class of cars, a
 * restaurant's table — has no route of its own: it is a row of its listing,
 * at the collection's prefix. The platform frames that page to show the owner
 * an entry, and its build refuses a collection with entries and no page there
 * (JTK_E_PAGE_NOT_BUILT), or an entry whose fields are annotated nowhere —
 * here every field the owner taps carries the entry's own annotation as the
 * kit's door writes it for a row (`page:<the entry's path>:blocks[0].<field>`
 * in contract 2), which is how a row of a listing opens its own entry in the
 * editor. Which fields those are is the platform's one rule (`tappable`):
 * this listing used to leave out `richtext_lite`, `markdown` and a gallery,
 * which the platform's build then refused as annotated nowhere.
 *
 * ── the booking page ────────────────────────────────────────────────────────
 *
 * The collection the diary sells from (`MODULES.bookings.services`) is listed
 * with the booking form under it: the rates and what they cost, then the form
 * that books them. `jtk create --kit` points the module's `page` setting here,
 * so the panel's *Try booking* opens it.
 *
 * ── a grouped collection ────────────────────────────────────────────────────
 *
 * A collection with `group` is listed under its headings (`site.groupsOf`,
 * the door's): a select's option labels in the options' order, or the titles
 * of the referenced collection's entries in that collection's order — a
 * salon's categories the owner adds in the panel. A category's title is that
 * entry's words, so the heading carries its annotation; a select's label is
 * the repository's and is fixed. What has no group comes last, under no heading. The booking form
 * is handed the same headings, words and not the stored value (12 October
 * 2026: it was handed `entry.data.group`, a field no catalogue was obliged to
 * have, and the option's raw value where it had).
 *
 * Plain on purpose, like `[...entry].astro`: this is what makes a site built
 * from a kit buildable on its first commit, not its design. What must survive
 * the design pass is every `data-jtk-path`.
 */
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.astro';
import EntryListing from '../components/EntryListing.astro';
import { Image } from 'astro:assets';
import { listsPaged, rowId, type Collection, type Entry } from '../lib/entries';
import { EVERY_LOCALE, langOf } from '../lib/locale';
import { site } from '../lib/site';
import { isUpload, uploaded } from '../lib/uploads';
import { photo } from '../lib/photos';

export async function getStaticPaths() {
  // A listing per language: `/services`, and `/de/services` beside it — where
  // the collection has one: a contract-3 collection shown only on other
  // pages has none unless it declares it.
  return site.collections.filter((one) => !one.pages || listsPaged(one)).flatMap((collection) =>
    EVERY_LOCALE.flatMap((locale) => {
      const listing = site.listingOf(collection.name, locale);
      return listing === undefined ? [] : [{ params: { listing: listing.slice(1) }, props: { collection, locale } }];
    }),
  );
}

const { collection, locale } = Astro.props as { collection: Collection; locale: string };
// A listing exists in every language the site has.
const alternates = EVERY_LOCALE.flatMap((one) => {
  const address = site.listingOf(collection.name, one);
  return address === undefined ? [] : [{ locale: one, address }];
});

// A collection with pages: its first page, and nothing below applies.
const paged = collection.pages ? site.listingPages(collection.name, locale) : undefined;

const entries: Entry[] = paged ? [] : site.entries(collection.name, { locale });
// Under their headings where the collection is grouped; one run with none
// where it is not, which draws exactly the flat list it always was.
const groups = site.groupsOf(collection.name, entries, locale) ?? [{ entries }];
const isGrouped = groups.some((one) => one.heading !== undefined);
// A row's title is a heading under the group's, and the page's second level
// where there are no groups.
const RowTitle = isGrouped ? 'h3' : 'h2';

// The fields a row shows: those the owner edits by tapping them, by the
// platform's one rule. The rest — a select, a number, a list of hours — are
// edited in the panel beside it.
const shown = collection.fields.filter((field) => site.tappable(field));

const lang = langOf(locale).slice(0, 2);
// The diary's settings: its `bookings_config` block, through the door.
const settings = site.module('bookings');

/** A length as the trade says it: whole days, whole hours, or minutes. */
function length(minutes: number): string {
  const [unit, n] = minutes % 1440 === 0 ? ['day', minutes / 1440] : minutes % 60 === 0 ? ['hour', minutes / 60] : ['minute', minutes];
  return new Intl.NumberFormat(langOf(locale), { style: 'unit', unit, unitDisplay: 'long' }).format(n);
}

/** A picture's file: a key in the studio's bucket the build downloaded, or a photograph this repository ships. */
const fileOf = (src: string): ImageMetadata | undefined => (isUpload(src) ? uploaded(src) : photo(src));

const bookings = site.rolesOf('bookings');
const sells = bookings?.services === collection.name;
const form = sells
  ? {
      // In the listing's order, group by group, each service carrying its
      // heading's words: the form draws a heading once per run, in the order
      // the runs come, and the run with none last.
      services: groups.flatMap((run) =>
        run.entries
          .filter((entry) => typeof entry.fields.value('takes') === 'number')
          .map((entry) => ({
            slug: entry.slug,
            title: String(entry.fields.value('title') ?? entry.slug),
            takes: entry.fields.value('takes') as number,
            costs: typeof entry.fields.value('costs') === 'number' ? (entry.fields.value('costs') as number) : undefined,
            group: run.heading?.text,
          })),
      ),
      resources: bookings?.resources
        ? site.entries(bookings.resources, { locale }).map((entry) => ({
            slug: entry.slug,
            title: String(entry.fields.value('title') ?? entry.slug),
            // What each does, for the form to grey the other services out once
            // they are chosen; empty is everything. Rows of `{ service }`, as
            // the kit and the panel write them.
            does: entry.fields.rows('does').map((row) => row.value('service') as string),
          }))
        : [],
      // The days the business opens, for the week of days: a closed day is
      // not a choice.
      open: [...new Set((Array.isArray(settings.hours) ? (settings.hours as { day: string }[]) : []).map((row) => row.day))],
    }
  : undefined;

const heading = site.words(collection.label, langOf(locale));
---

{paged && (
  <EntryListing collection={collection} locale={locale} entries={paged.entries.slice(0, paged.size)} current={1} last={paged.last} alternates={alternates} />
)}
{!paged && (
<Layout title={heading} description="" alternates={alternates}>
  <main id="content">
    <section class="listing">
      {/* The collection's own name, from the catalogue: the repository's, not a
          field of any entry — fixed, as the check asks it to be said. */}
      <h1 data-jtk-fixed>{heading}</h1>
      {
        groups.map((run) => (
          <Fragment>
            {/* A category's title is that entry's, and taps open it; a
                select's label is the repository's, fixed. */}
            {run.heading && (
              <h2 class="listing-group" {...run.heading.at} data-jtk-fixed={run.heading.fixed ? true : undefined}>{run.heading.text}</h2>
            )}
            <ul class="listing-rows">
              {
                run.entries.map((entry) => {
                  const { fields } = entry;
                  return (
                    <li class="listing-row" id={rowId(entry)}>
                      {shown.map((field) => {
                        const value = fields.value(field.key);
                        if (value === undefined) return null;
                        if (field.kind === 'media' && field.multiple === true) {
                          return fields.gallery(field.key).map((picture) => {
                            const file = fileOf(picture.src);
                            if (!file) return null;
                            return <Image src={file} alt={picture.alt} data-jtk-path={picture['data-jtk-path']} widths={[480, 960]} sizes="(min-width: 900px) 20rem, 92vw" layout="none" />;
                          });
                        }
                        if (field.kind === 'media') {
                          const picture = fields.picture(field.key);
                          const file = fileOf(picture.src);
                          if (!file) return null;
                          return <Image src={file} alt={picture.alt} data-jtk-path={picture['data-jtk-path']} widths={[480, 960]} sizes="(min-width: 900px) 20rem, 92vw" layout="none" />;
                        }
                        if (field.kind === 'duration') return <span {...fields.at(field.key)}>{length(Number(value))}</span>;
                        if (field.kind === 'money') return <span {...fields.at(field.key)}>{site.money(value, locale)}</span>;
                        if (field.key === 'title') return <RowTitle {...fields.at(field.key)}>{String(value)}</RowTitle>;
                        return <p {...fields.at(field.key)}>{String(value)}</p>;
                      })}
                    </li>
                  );
                })
              }
            </ul>
          </Fragment>
        ))
      }
    </section>

    {
      form && form.services.length > 0 && (
        <section class="listing-book">
          <BookingForm
            services={form.services}
            resources={form.resources}
            open={form.open}
            locale={(['uk', 'de', 'en'].includes(lang) ? lang : 'en') as 'uk' | 'de' | 'en'}
            combine={settings.combine === true}
            scale={typeof settings.scale === 'string' ? settings.scale : ''}
            kind={typeof settings.kind === 'string' ? settings.kind : ''}
            currency={site.currency || undefined}
          />
        </section>
      )
    }
  </main>
</Layout>
)}
