---
/**
 * The listing of a collection without pages — and, for the diary's services,
 * the page a visitor books on.
 *
 * ── why every such collection has one ───────────────────────────────────────
 *
 * An entry of a collection with `pages: false` — a rate, a class of cars, a
 * restaurant's table — has no route of its own: it is a row of its listing,
 * at the collection's prefix. The platform frames that page to show the owner
 * an entry, and its build refuses a collection with entries and no page there
 * (JTK_E_PAGE_NOT_BUILT), or an entry whose fields are annotated nowhere —
 * here they carry `page:<the entry's path>:blocks[0].<field>`, which is how a
 * row of a listing opens its own entry in the editor.
 *
 * ── the booking page ────────────────────────────────────────────────────────
 *
 * The collection the diary sells from (`MODULES.bookings.services`) is listed
 * with the booking form under it: the rates and what they cost, then the form
 * that books them. `jtk create --kit` points the module's `page` setting here,
 * so the panel's *Try booking* opens it.
 *
 * ── a grouped collection ────────────────────────────────────────────────────
 *
 * A collection with `group` is listed under its headings (`groupsOf` in
 * lib/entries, the rules in lib/groups): a select's option labels in the
 * options' order, or the titles of the referenced collection's entries in that
 * collection's order — a salon's categories the owner adds in the panel. A
 * category's title is that entry's words, so the heading carries its
 * `page:<address>:blocks[0].title`; a select's label is the repository's and
 * is fixed. What has no group comes last, under no heading. The booking form
 * is handed the same headings, words and not the stored value (12 October
 * 2026: it was handed `entry.data.group`, a field no catalogue was obliged to
 * have, and the option's raw value where it had).
 *
 * Plain on purpose, like `[...entry].astro`: this is what makes a site built
 * from a kit buildable on its first commit, not its design. What must survive
 * the design pass is every `data-jtk-path`.
 */
import Layout from '../layouts/Layout.astro';
import { siteCurrency } from '../lib/site';
import BookingForm from '../components/BookingForm.astro';
import { Image } from 'astro:assets';
import { BLOCKS, COLLECTIONS, MODULES, words, type Collection, type Field } from '../content/blocks';
import { groupsOf, listed, slugOf, type Entry } from '../lib/entries';
import { EVERY_LOCALE, langOf, withLocale } from '../lib/locale';
import { isUpload, uploaded } from '../lib/uploads';
import { photo } from '../lib/photos';
import { money as priced } from '../lib/money';

export async function getStaticPaths() {
  // A listing per language: `/services`, and `/de/services` beside it.
  return COLLECTIONS.filter((one) => one.pages === false).flatMap((collection) =>
    EVERY_LOCALE.map((locale) => ({
      params: { listing: `${locale === '' ? '' : `${locale}/`}${collection.prefix.replace(/^\//, '')}` },
      props: { collection, locale },
    })),
  );
}

const { collection, locale } = Astro.props as { collection: Collection; locale: string };
const entries: Entry[] = await listed(collection.name, locale);
// A listing exists in every language the site has.
const alternates = EVERY_LOCALE.map((one) => ({ locale: one, path: withLocale(one, collection.prefix) }));
const type = BLOCKS.find((one) => one.type === collection.type);
// Under their headings where the collection is grouped; one run with none
// where it is not, which draws exactly the flat list it always was.
const groups = (await groupsOf(collection, entries, locale)) ?? [{ entries }];
const isGrouped = groups.some((one) => one.heading !== undefined);
// A row's title is a heading under the group's, and the page's second level
// where there are no groups.
const RowTitle = isGrouped ? 'h3' : 'h2';

// The fields a row shows: those the owner edits by tapping them. The rest —
// a select, a number, a list of hours — are edited in the panel beside it.
const TAPPABLE = new Set(['text', 'textarea', 'money', 'duration', 'media']);
const shown: Field[] = (type?.fields ?? []).filter(
  (field) => TAPPABLE.has(field.kind) && field.client_editable !== false && field.no_tap_target !== true && field.multiple !== true,
);

const lang = langOf(locale).slice(0, 2);
const settingsFiles = import.meta.glob<{ blocks?: Record<string, unknown>[] }>('/jtk/bookings.json', { eager: true, import: 'default' });
const settings = Object.values(settingsFiles)[0]?.blocks?.[0] ?? {};
// The site's, as the platform wrote it (lib/site): never a page's own.
const currency = siteCurrency;

/** A length as the trade says it: whole days, whole hours, or minutes. */
function length(minutes: number): string {
  const [unit, n] = minutes % 1440 === 0 ? ['day', minutes / 1440] : minutes % 60 === 0 ? ['hour', minutes / 60] : ['minute', minutes];
  return new Intl.NumberFormat(langOf(locale), { style: 'unit', unit, unitDisplay: 'long' }).format(n);
}

const money = (minor: number): string => priced(minor, currency, langOf(locale));

const bookings = MODULES.bookings;
const sells = bookings?.services === collection.name;
const form = sells
  ? {
      // In the listing's order, group by group, each service carrying its
      // heading's words: the form draws a heading once per run, in the order
      // the runs come, and the run with none last.
      services: groups.flatMap((run) =>
        run.entries
          .filter((entry) => typeof entry.data.takes === 'number')
          .map((entry) => ({
            slug: slugOf(entry),
            title: String(entry.data.title ?? entry.id),
            takes: entry.data.takes as number,
            costs: typeof entry.data.costs === 'number' ? entry.data.costs : undefined,
            group: run.heading?.text,
          })),
      ),
      resources: bookings?.resources
        ? (await listed(bookings.resources, locale)).map((entry) => ({
            slug: slugOf(entry),
            title: String(entry.data.title ?? entry.id),
            // What each does, for the form to grey the other services out once
            // they are chosen; empty is everything.
            does: (Array.isArray(entry.data.does) ? (entry.data.does as { service: string }[]) : []).map((row) => row.service),
          }))
        : [],
      // The days the business opens, for the week of days: a closed day is
      // not a choice.
      open: [...new Set(((settings.hours as { day: string }[] | undefined) ?? []).map((row) => row.day))],
    }
  : undefined;

const heading = words(collection.label, langOf(locale));
---

<Layout title={heading} description="" alternates={alternates}>
  <main id="content">
    <section class="listing">
      {/* The collection's own name, from the catalogue: the repository's, not a
          field of any entry — fixed, as the check asks it to be said. */}
      <h1 data-jtk-fixed>{heading}</h1>
      {
        groups.map((run) => (
          <Fragment>
            {/* A category's title is that entry's, and taps open it; a
                select's label is the repository's, fixed. */}
            {run.heading && (
              <h2 class="listing-group" data-jtk-path={run.heading.path} data-jtk-fixed={run.heading.path ? undefined : true}>{run.heading.text}</h2>
            )}
            <ul class="listing-rows">
              {
                run.entries.map((entry) => {
                  const at = withLocale(locale, `${collection.prefix}/${slugOf(entry)}`);
                  return (
                    <li class="listing-row" id={`${collection.name}-${slugOf(entry)}`}>
                      {shown.map((field) => {
                        const value = entry.data[field.key];
                        if (value === undefined || value === null || value === '') return null;
                        const path = `page:${at}:blocks[0].${field.key}`;
                        if (field.kind === 'media') {
                          const src = String(value);
                          const file = isUpload(src) ? uploaded(src) : photo(src);
                          if (!file) return null;
                          return <Image src={file} alt={String(entry.data.title ?? '')} data-jtk-path={path} widths={[480, 960]} sizes="(min-width: 900px) 20rem, 92vw" layout="none" />;
                        }
                        if (field.kind === 'duration') return <span data-jtk-path={path}>{length(Number(value))}</span>;
                        if (field.kind === 'money') return <span data-jtk-path={path}>{money(Number(value))}</span>;
                        if (field.key === 'title') return <RowTitle data-jtk-path={path}>{String(value)}</RowTitle>;
                        return <p data-jtk-path={path}>{String(value)}</p>;
                      })}
                    </li>
                  );
                })
              }
            </ul>
          </Fragment>
        ))
      }
    </section>

    {
      form && form.services.length > 0 && (
        <section class="listing-book">
          <BookingForm
            services={form.services}
            resources={form.resources}
            open={form.open}
            locale={(['uk', 'de', 'en'].includes(lang) ? lang : 'en') as 'uk' | 'de' | 'en'}
            combine={settings.combine === true}
            scale={typeof settings.scale === 'string' ? settings.scale : ''}
            kind={typeof settings.kind === 'string' ? settings.kind : ''}
            currency={currency || undefined}
          />
        </section>
      )
    }
  </main>
</Layout>
