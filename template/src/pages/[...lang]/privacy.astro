---
/**
 * A privacy page, as a starting point.
 *
 * ── what the platform requires, which is one line of this file ──────────────
 *
 * **The link, and nothing else.** The platform walks the built artifact looking
 * for `PROCESSING_URL`, and it does not read a word around it. Everything else
 * on this page — the sections, the wording, whether this file is used at all —
 * belongs to the business, and grading it is neither a website builder's job
 * nor within its competence.
 *
 * So this is a default and not a specification. Rewrite it, restyle it, replace
 * it with a page written by somebody's lawyer, or put the link on a privacy
 * page that already exists and delete this file. All of those are correct.
 *
 * What is not correct is dropping the link: it is the one sentence here that is
 * about somebody other than the business, and without it nothing on the site
 * tells a visitor who is holding what they typed.
 *
 * ── and it is not a wall ────────────────────────────────────────────────────
 *
 * A site missing this is **warned about and launched anyway**. Publishing a
 * notice is the controller's obligation — the business's — and what makes the
 * platform's own handling lawful is the agreement with them rather than a page
 * here: gate on our own conduct, never on somebody else's compliance. The one thing publishing does refuse is a form with nowhere to
 * send what people write in it, which is a broken product rather than a legal
 * opinion.
 */
import Layout from '../../layouts/Layout.astro';
import { copyFor } from '../../copy';
import { localeOf, localeParams, withLocale, EVERY_LOCALE } from '../../lib/locale';

export const getStaticPaths = localeParams;

const locale = localeOf(Astro.url.pathname);
const { PRIVACY, WORDS_LANG } = copyFor(locale);
// A page written in code exists in every language the site has.
const alternates = EVERY_LOCALE.map((one) => ({ locale: one, address: withLocale(one, '/privacy') }));
import { PROCESSING_URL } from '../../content/blocks';
import { photoWords } from '@jtakeit/kit/lead';
import { langOf } from '../../lib/locale';
import { site } from '../../lib/site';
// A form that takes photographs says what becomes of them — the law asks the
// business to, and the platform's part is the kit's sentence (wiki/87).
const takesPhotos = site.types.some((block) => block.collects === 'enquiry' && (block.photos ?? 0) > 0);
const photosSentence = photoWords(langOf(locale)).privacy;
import { BUSINESS } from '../../data/site';
// Who «we» are, under the page's last heading: the business's name, address
// and how to reach it, from the shared contacts the owner keeps (by role),
// and src/data/site.ts where they say nothing — as the head and llms.txt
// say them. The heading stood alone with nothing under it until somebody
// wrote it in (the two-language rehearsal, 12 November 2026).
// Contract 3's: contract 2 keeps the heading for the developer to write under.
const facts = site.facts(locale);
const fact = (role: string, own: string): string => facts.text(role).trim() || own;
const who =
  site.contract !== 3
    ? []
    : [
        fact('name', BUSINESS.name),
        fact('street', BUSINESS.street),
        [fact('postal_code', BUSINESS.postalCode), fact('city', BUSINESS.city)].filter(Boolean).join(' '),
        [fact('phone', BUSINESS.phoneDisplay), fact('email', BUSINESS.email)].filter(Boolean).join(' · '),
      ].filter(Boolean);
// The business's own words, where the site has the page (jtk/pages/privacy.json,
// the owner, 26 November 2026: «the privacy text editable»): each field its
// words, or the default above standing in until it is written — annotated
// either way, so a tap opens the field. A site without the page keeps the
// default, as code.
const page = site.page('/privacy', locale);
const own = page.blocks.some((one) => one.type === 'privacy');
const block = page.block('privacy');
const said = (key: string, standIn: string) => {
  const text = own ? block.text(key) : '';
  return {
    text: text || standIn,
    attrs: own ? { ...block.at(key), ...(text ? block.lang(key) : { lang: WORDS_LANG || undefined }) } : { 'data-jtk-fixed': true, lang: WORDS_LANG || undefined },
  };
};
// Who «we» are is the shared contacts' — a tap opens them; on a site that
// keeps them in code, the lines are the design's.
// Each value its own span, annotated with its field where the contacts hold
// it (a tap opens it, as on the imprint); the code's where they do not.
const value = (role: string, own: string) => {
  const held = contract3Fact(role);
  return { text: held || own, attrs: held ? facts.at(role) : { 'data-jtk-fixed': true } };
};
function contract3Fact(role: string): string {
  return site.contract === 3 ? facts.text(role).trim() : '';
}
const whoLines =
  site.contract !== 3
    ? []
    : [
        [value('name', BUSINESS.name)],
        [value('street', BUSINESS.street)],
        [value('postal_code', BUSINESS.postalCode), value('city', BUSINESS.city)],
        [value('phone', BUSINESS.phoneDisplay), value('email', BUSINESS.email)],
      ]
        .map((line) => line.filter((one) => one.text !== ''))
        .filter((line) => line.length > 0);
const title = said('title', PRIVACY.title);
const intro = said('intro', PRIVACY.intro);
const formTitle = said('form_title', PRIVACY.formTitle);
const formBody = said('form_body', PRIVACY.formBody);
const askTitle = said('ask_title', PRIVACY.askTitle);
const askBody = said('ask_body', PRIVACY.askBody);
---

<Layout title={title.text} description={intro.text} alternates={alternates}>
  <main id="content" class="prose">
    <h1 {...title.attrs}>{title.text}</h1>
    <p class="lead" {...intro.attrs}>{intro.text}</p>

    <h2 {...formTitle.attrs}>{formTitle.text}</h2>
    <p {...formBody.attrs}>{formBody.text}</p>
    {takesPhotos && <p data-jtk-fixed lang={WORDS_LANG || undefined}>{photosSentence}</p>}

    {/* The platform's part — who else holds what a visitor sends — as it is. */}
    <h2 data-jtk-fixed lang={WORDS_LANG || undefined}>{PRIVACY.whoTitle}</h2>
    <p data-jtk-fixed lang={WORDS_LANG || undefined}>
      {PRIVACY.whoBody}{' '}
      <a href={PROCESSING_URL} rel="noreferrer">{PROCESSING_URL.replace('https://', '')}</a>
    </p>

    <h2 {...askTitle.attrs}>{askTitle.text}</h2>
    <p {...askBody.attrs}>{askBody.text}</p>

    {/*
      The business's own. Left visible rather than commented out, so that an
      empty one is noticed before launch rather than after.
    */}
    <h2 data-jtk-fixed lang={WORDS_LANG || undefined}>{PRIVACY.ownTitle}</h2>
    {whoLines.length > 0 && (
      <address>
        {whoLines.map((line, i) => (
          <Fragment>
            {i > 0 && <br />}
            {line.map((one, at) => (
              <Fragment>
                {at > 0 && <span data-jtk-fixed>{i === 3 ? ' · ' : ' '}</span>}
                <span {...one.attrs}>{one.text}</span>
              </Fragment>
            ))}
          </Fragment>
        ))}
      </address>
    )}
  </main>
</Layout>
