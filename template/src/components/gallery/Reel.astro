---
/**
 * `coverflow` and `focus`: one row, scrolled by the visitor, with the piece in
 * the middle given the stage.
 *
 *   · coverflow — the pieces either side are turned away in depth, like
 *     records in a crate;
 *   · focus — they are racked out of focus like a lens: softer, smaller,
 *     quieter by how far they sit from the middle.
 *
 * Both are the strip's honest mechanics underneath: native horizontal
 * scrolling, snapped to the centre, so a trackpad, a thumb's momentum and the
 * keyboard behave the way the platform does. A script only *reads* the scroll
 * position and dresses each piece by its distance from the middle; it never
 * moves anything itself. Without a script, or with reduced motion, it is a
 * plain snapped strip.
 */
import Shot from '../Shot.astro';
import type { Piece } from './galleries';

interface Props {
  pieces: Piece[];
  mode: 'coverflow' | 'focus';
  /** The pieces' proportions. */
  ratio?: string;
}

const { pieces, mode, ratio = mode === 'focus' ? '3 / 2' : '3 / 4' } = Astro.props;
const width = mode === 'focus' ? 'min(max(64vw, 18rem), 56rem)' : 'min(18rem, 64vw)';
---

<div class:list={['reel', `reel--${mode}`]} data-reel={mode} style={`--reel-w:${width};--reel-ratio:${ratio}`} role="region" aria-roledescription="carousel" aria-label="Work" tabindex="0">
  <div class="reel__track" data-track>
    {
      pieces.map((piece, i) => (
        <figure class="reel__piece" data-i={i}>
          <Shot name={piece.name} alt={piece.alt} path={piece.path} ratio={ratio} width={mode === 'focus' ? 1400 : 700} sizes={mode === 'focus' ? '(min-width: 62rem) 56rem, 80vw' : '(min-width: 48rem) 18rem, 64vw'} eager={i < 3} />
        </figure>
      ))
    }
  </div>
  <div class="reel__bar">
    <p class="reel__caption" data-caption aria-live="polite">{pieces[0]?.caption ?? ''}</p>
    <span class="reel__count"><b data-at>01</b> / {String(pieces.length).padStart(2, '0')}</span>
    <span class="reel__nav">
      <button type="button" class="reel__btn" data-prev aria-label="Previous">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
      <button type="button" class="reel__btn" data-next aria-label="Next">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m6 3 5 5-5 5" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
    </span>
  </div>
  <div class="reel__progress" aria-hidden="true"><i data-progress></i></div>
  <template data-captions>{JSON.stringify(pieces.map((p) => p.caption ?? ''))}</template>
</div>

<style>
  .reel {
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
    outline: none;
  }

  .reel:focus-visible {
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .reel__track {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    /* The first and last piece can reach the middle. */
    padding-inline: calc(50% - var(--reel-w) / 2);
    padding-block: clamp(1rem, 3vw, 2.5rem);
    scrollbar-width: none;
  }

  .reel__track::-webkit-scrollbar {
    display: none;
  }

  .reel--coverflow .reel__track {
    perspective: 1200px;
    gap: 0;
  }

  .reel__piece {
    flex: 0 0 var(--reel-w);
    margin: 0;
    scroll-snap-align: center;
    transform-origin: center;
    will-change: transform, filter;
  }

  .reel__piece :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    border-radius: var(--r-2, 0.5rem);
    user-select: none;
  }

  .reel--coverflow .reel__piece :global(img) {
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.55);
  }

  .reel__bar {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.5rem);
    padding-inline: clamp(1rem, 4vw, 3.5rem);
  }

  .reel__caption {
    flex: 1;
    min-inline-size: 0;
    margin: 0;
    color: var(--ink-quiet);
  }

  .reel__count {
    font-variant-numeric: tabular-nums;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--ink-quiet);
  }

  .reel__count b {
    color: var(--ink);
    font-weight: 600;
  }

  .reel__nav {
    display: flex;
    gap: 0.4rem;
  }

  .reel__btn {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--line-strong, currentColor);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .reel__btn:hover {
    background: var(--ink);
    color: var(--paper, #fff);
  }

  .reel__progress {
    block-size: 1px;
    margin-inline: clamp(1rem, 4vw, 3.5rem);
    background: var(--line);
  }

  .reel__progress i {
    display: block;
    block-size: 100%;
    background: var(--ink);
    transform-origin: left;
    transform: scaleX(var(--reel-p, 0));
  }

  :global(html:not(.js)) .reel__btn,
  :global(html:not(.js)) .reel__progress {
    visibility: hidden;
  }
</style>

<script>
  import { onAlive } from '../../lib/alive';

  onAlive('[data-reel]', (node) => {
    const root = node as HTMLElement;
    const mode = root.getAttribute('data-reel');
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const pieces = [...track.querySelectorAll<HTMLElement>('.reel__piece')];
    const n = pieces.length;
    if (n < 2) return;
    const at = root.querySelector<HTMLElement>('[data-at]');
    const caption = root.querySelector<HTMLElement>('[data-caption]');
    const progress = root.querySelector<HTMLElement>('[data-progress]');
    let captions: string[] = [];
    try {
      captions = JSON.parse(root.querySelector('template[data-captions]')?.innerHTML ?? '[]');
    } catch {
      /* the reel works without words */
    }
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let active = -1;

    /** Dress every piece by its distance from the middle, in piece widths. */
    const paint = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      const w = pieces[0].offsetWidth || 1;
      let near = 0;
      let best = Infinity;
      pieces.forEach((piece, i) => {
        const d = (piece.offsetLeft + piece.offsetWidth / 2 - mid) / w;
        if (Math.abs(d) < best) {
          best = Math.abs(d);
          near = i;
        }
        if (still.matches) {
          piece.style.transform = '';
          piece.style.filter = '';
          piece.style.opacity = '';
          return;
        }
        const a = Math.min(Math.abs(d), 1);
        if (mode === 'coverflow') {
          const c = Math.max(-1.5, Math.min(1.5, d));
          piece.style.transform = `translateZ(${-Math.abs(c) * 160}px) rotateY(${-c * 40}deg) scale(${1 - a * 0.08})`;
          piece.style.zIndex = String(100 - Math.round(Math.abs(d) * 10));
          piece.style.filter = `brightness(${1 - a * 0.35})`;
        } else {
          const blur = Math.min(Math.abs(d), 2) * 7;
          piece.style.transform = `scale(${1 - 0.14 * a})`;
          piece.style.filter = blur > 0.05 ? `blur(${blur.toFixed(2)}px) saturate(${(1 - 0.45 * a).toFixed(3)})` : 'none';
          piece.style.opacity = (1 - 0.5 * a).toFixed(3);
        }
      });
      const max = track.scrollWidth - track.clientWidth;
      progress?.style.setProperty('--reel-p', max > 0 ? (track.scrollLeft / max).toFixed(4) : '0');
      if (near !== active) {
        active = near;
        if (at) at.textContent = String(near + 1).padStart(2, '0');
        if (caption) caption.textContent = captions[near] ?? '';
        pieces.forEach((p, i) => (i === near ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
      }
    };

    let raf = 0;
    const soon = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          paint();
        });
    };
    track.addEventListener('scroll', soon, { passive: true });
    new ResizeObserver(soon).observe(track);
    still.addEventListener('change', soon);

    const go = (i: number) => {
      const piece = pieces[((i % n) + n) % n];
      track.scrollTo({ left: piece.offsetLeft + piece.offsetWidth / 2 - track.clientWidth / 2, behavior: still.matches ? 'auto' : 'smooth' });
    };
    root.querySelector('[data-next]')?.addEventListener('click', () => go(active + 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(active - 1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(active + 1);
      else if (e.key === 'ArrowLeft') go(active - 1);
      else return;
      e.preventDefault();
    });
    // A tap on a piece at the side brings it to the middle.
    pieces.forEach((piece, i) => piece.addEventListener('click', () => i !== active && go(i)));

    // A mouse can drag the row the way a thumb does; touch and trackpads
    // scroll natively and need nothing.
    let drag: { x: number; left: number; moved: boolean } | null = null;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      drag = { x: e.clientX, left: track.scrollLeft, moved: false };
    });
    track.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      if (!drag.moved && Math.abs(dx) > 4) {
        drag.moved = true;
        track.style.scrollSnapType = 'none';
        track.setPointerCapture(e.pointerId);
      }
      if (drag.moved) track.scrollLeft = drag.left - dx;
    });
    const release = () => {
      if (!drag) return;
      const moved = drag.moved;
      drag = null;
      track.style.scrollSnapType = '';
      if (moved) go(active);
    };
    track.addEventListener('pointerup', release);
    track.addEventListener('pointercancel', release);

    paint();
  });
</script>
