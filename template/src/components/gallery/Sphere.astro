---
/**
 * `sphere`: the work spread over a globe the visitor turns.
 *
 * The pieces sit on a Fibonacci sphere — evenly, with no seam and no crowded
 * pole — in small round frames. A drag turns it, and it keeps turning a little
 * after the hand lets go; the near side is large, the far side fades away. A
 * tap opens the piece in a dialog.
 *
 * It also turns slowly by itself, which makes it a thing that moves forever,
 * so it is bounded the way the wall is:
 *
 *   · it declares itself (`data-motion="gallery"`), and `jt-check` counts it;
 *   · it stops under the pointer, on keyboard focus, and off screen;
 *   · reduced motion gets it still — turned by hand only.
 *
 * Without a script it is a contact sheet of the same pieces, every one of
 * them there.
 */
import Shot from '../Shot.astro';
import type { Piece } from './galleries';

interface Props {
  pieces: Piece[];
}

const { pieces } = Astro.props;
---

<div class="sphere" data-sphere data-motion="gallery" role="region" aria-label="Work" tabindex="0">
  <div class="sphere__stage" data-stage>
    {
      pieces.map((piece, i) => (
        <button type="button" class="sphere__node" data-i={i} aria-label={piece.alt || piece.caption || `${i + 1}`}>
          <Shot name={piece.name} alt="" decorative path={piece.path} ratio="1 / 1" width={300} sizes="8rem" />
        </button>
      ))
    }
  </div>
  <dialog class="sphere__dialog" data-dialog>
    <form method="dialog" class="sphere__close-form">
      <button class="sphere__close" aria-label="Close">×</button>
    </form>
    <img class="sphere__big" data-big alt="" />
    <p class="sphere__words" data-words></p>
  </dialog>
  <template data-captions>{JSON.stringify(pieces.map((p) => p.caption ?? ''))}</template>
</div>

<style>
  .sphere {
    display: grid;
    place-items: center;
    outline: none;
  }

  .sphere__stage {
    position: relative;
    inline-size: min(40rem, 92vw);
    aspect-ratio: 1;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .sphere__stage[data-drag] {
    cursor: grabbing;
  }

  .sphere__node {
    position: absolute;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inline-size: var(--node, 13%);
    aspect-ratio: 1;
    padding: 0;
    overflow: hidden;
    border: 2px solid rgb(255 255 255 / 0.25);
    border-radius: 50%;
    background: var(--panel, #222);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.6);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: scale 0.2s ease;
  }

  .sphere__node:hover,
  .sphere__node:focus-visible {
    scale: 1.15;
  }

  .sphere__node :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Without a script: a contact sheet of the same pieces. */
  :global(html:not(.js)) .sphere__stage {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5rem, 1fr));
    gap: 0.5rem;
    aspect-ratio: auto;
  }

  :global(html:not(.js)) .sphere__node {
    position: static;
    inline-size: auto;
    transform: none;
  }

  .sphere__dialog {
    max-inline-size: min(40rem, 92vw);
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--r-3, 1rem);
    background: var(--paper, #fff);
    color: var(--ink);
  }

  .sphere__dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(4px);
  }

  .sphere__dialog[open] {
    animation: sphere-in 0.3s ease-out;
  }

  @keyframes sphere-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
  }

  .sphere__big {
    display: block;
    inline-size: 100%;
    max-block-size: 75svh;
    object-fit: cover;
  }

  .sphere__words {
    margin: 0;
    padding: 1rem 1.25rem;
  }

  .sphere__words:empty {
    display: none;
  }

  .sphere__close-form {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
    margin: 0;
  }

  .sphere__close {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.5);
    color: #fff;
    font-size: 1.25rem;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .sphere__dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  import { onAlive } from '../../lib/alive';

  onAlive('[data-sphere]', (node) => {
    const root = node as HTMLElement;
    const stage = root.querySelector<HTMLElement>('[data-stage]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-dialog]');
    if (!stage) return;
    const nodes = [...stage.querySelectorAll<HTMLElement>('.sphere__node')];
    const n = nodes.length;
    if (n === 0) return;
    let captions: string[] = [];
    try {
      captions = JSON.parse(root.querySelector('template[data-captions]')?.innerHTML ?? '[]');
    } catch {
      /* fine without words */
    }
    const still = matchMedia('(prefers-reduced-motion: reduce)');

    // Fibonacci sphere: even, no seam, no crowded pole. Kept off the very
    // poles, where a piece would only ever be seen edge-on.
    const golden = Math.PI * (3 - Math.sqrt(5));
    const points = nodes.map((_, i) => {
      const y = 1 - ((i + 0.5) / n) * 2 * 0.86;
      const r = Math.sqrt(1 - y * y);
      const a = golden * i;
      return { x: Math.cos(a) * r, y, z: Math.sin(a) * r };
    });

    let rx = -0.25;
    let ry = 0.3;
    let vx = 0;
    let vy = 0;
    let dragging = false;
    let hovering = false;
    let seen = false;
    let raf = 0;
    const SPIN = 0.0025;

    const paint = () => {
      const size = stage.clientWidth;
      const R = size * 0.38;
      const cx = Math.cos(rx);
      const sx = Math.sin(rx);
      const cy = Math.cos(ry);
      const sy = Math.sin(ry);
      points.forEach((p, i) => {
        // Turn about Y (a drag across), then about X (a drag up or down).
        const x1 = p.x * cy + p.z * sy;
        const z1 = -p.x * sy + p.z * cy;
        const y2 = p.y * cx - z1 * sx;
        const z2 = p.y * sx + z1 * cx;
        const depth = (z2 + 1) / 2; // 0 far, 1 near
        const node = nodes[i];
        const scale = 0.45 + depth * 0.75;
        node.style.transform = `translate(calc(-50% + ${(x1 * R).toFixed(1)}px), calc(-50% + ${(y2 * R).toFixed(1)}px)) scale(${scale.toFixed(3)})`;
        node.style.zIndex = String(Math.round(depth * 1000));
        const fade = z2 < -0.15 ? Math.max(0, (z2 + 0.55) / 0.4) : 1;
        node.style.opacity = fade.toFixed(3);
        node.style.visibility = fade < 0.02 ? 'hidden' : '';
        node.tabIndex = z2 > 0.2 ? 0 : -1;
      });
    };

    const tick = () => {
      raf = 0;
      if (!dragging) {
        vx *= 0.94;
        vy *= 0.94;
        const turns = !still.matches && !hovering && seen && !root.matches(':focus-within');
        ry += vy + (turns ? SPIN : 0);
        rx = Math.max(-1.1, Math.min(1.1, rx + vx));
      }
      paint();
      const moving = dragging || Math.abs(vx) > 0.0001 || Math.abs(vy) > 0.0001 || (!still.matches && !hovering && seen);
      if (moving) raf = requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    new IntersectionObserver(([e]) => {
      seen = e.isIntersecting;
      if (seen) wake();
    }).observe(root);
    new ResizeObserver(() => paint()).observe(stage);
    stage.addEventListener('pointerenter', () => (hovering = true));
    stage.addEventListener('pointerleave', () => {
      hovering = false;
      wake();
    });
    root.addEventListener('focusout', wake);

    // A drag turns it; a press that does not move is a tap and opens the piece.
    let last: { x: number; y: number; moved: boolean; node: HTMLElement | null } | null = null;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      const node = e.target instanceof Element ? (e.target.closest('.sphere__node') as HTMLElement | null) : null;
      last = { x: e.clientX, y: e.clientY, moved: false, node };
      dragging = true;
      vx = vy = 0;
      stage.setPointerCapture(e.pointerId);
      wake();
    });
    stage.addEventListener('pointermove', (e) => {
      if (!last) return;
      const dx = e.clientX - last.x;
      const dy = e.clientY - last.y;
      if (!last.moved && Math.hypot(dx, dy) < 5) return;
      if (!last.moved) stage.setAttribute('data-drag', '');
      last.moved = true;
      vy = dx * 0.005;
      vx = -dy * 0.005;
      ry += vy;
      rx = Math.max(-1.1, Math.min(1.1, rx + vx));
      last.x = e.clientX;
      last.y = e.clientY;
    });
    const release = () => {
      if (!last) return;
      const tapped = !last.moved ? last.node : null;
      last = null;
      dragging = false;
      stage.removeAttribute('data-drag');
      wake();
      if (tapped) open(Number(tapped.dataset.i));
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);
    // The keyboard opens a piece with Enter, like any button.
    nodes.forEach((node, i) =>
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i);
        }
      }),
    );

    const open = (i: number) => {
      if (!dialog || typeof dialog.showModal !== 'function') return;
      const img = nodes[i].querySelector('img');
      const big = dialog.querySelector<HTMLImageElement>('[data-big]');
      const words = dialog.querySelector<HTMLElement>('[data-words]');
      if (big && img) {
        big.src = img.currentSrc || img.src;
        big.srcset = img.srcset;
        big.sizes = '(min-width: 40rem) 40rem, 92vw';
        big.alt = nodes[i].getAttribute('aria-label') ?? '';
      }
      if (words) words.textContent = captions[i] ?? '';
      dialog.showModal();
    };
    dialog?.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    paint();
    wake();
  });
</script>
