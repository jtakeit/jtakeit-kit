---
/**
 * `stage`: one large frame, and a row of small ones over its foot.
 *
 * For a portfolio somebody browses: every piece one tap away, the chosen one
 * shown large. Both rows are native, snapped scrolling — a swipe on the large
 * frame is a swipe, and the thumbnails follow it; a tap on a thumbnail brings
 * its piece up. Without a script the thumbnails are links to their pieces, so
 * the gallery still works, only less smoothly.
 */
import Shot from '../Shot.astro';
import type { Piece } from './galleries';

interface Props {
  pieces: Piece[];
  /** The large frame's proportions. */
  ratio?: string;
}

const { pieces, ratio = '3 / 2' } = Astro.props;
const id = `stage-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="stage" data-stage style={`--stage-ratio:${ratio}`} role="region" aria-roledescription="carousel" aria-label="Work">
  <div class="stage__main" data-main tabindex="0">
    {
      pieces.map((piece, i) => (
        <figure class="stage__slide" id={`${id}-${i}`} aria-label={`${i + 1} / ${pieces.length}`}>
          <Shot name={piece.name} alt={piece.alt} path={piece.path} ratio={ratio} width={1200} sizes="(min-width: 54rem) 52rem, 100vw" eager={i === 0} />
          {piece.caption && (
            <figcaption class="stage__caption" data-jtk-path={piece.captionPath}>
              {piece.caption}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>
  <nav class="stage__thumbs" data-thumbs aria-label="Pieces">
    {
      pieces.map((piece, i) => (
        <a class="stage__thumb" href={`#${id}-${i}`} data-i={i} aria-current={i === 0 ? 'true' : undefined}>
          <Shot name={piece.name} alt="" decorative ratio="1 / 1" width={200} sizes="5rem" />
        </a>
      ))
    }
  </nav>
</div>

<style>
  .stage {
    position: relative;
    inline-size: min(100%, 52rem);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--r-3, 1rem);
    background: var(--panel, #111);
  }

  .stage__main {
    position: relative;
    display: flex;
    /* A seam between the pictures: without it two frames pass under a swipe
       as one long picture. */
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    outline: none;
  }

  .stage__main::-webkit-scrollbar {
    display: none;
  }

  .stage__main:focus-visible {
    box-shadow: inset 0 0 0 2px var(--ink);
  }

  .stage__slide {
    position: relative;
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
    aspect-ratio: var(--stage-ratio);
  }

  .stage__slide :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .stage__caption {
    position: absolute;
    inset-inline-start: clamp(1rem, 3vw, 2rem);
    inset-block-start: clamp(1rem, 3vw, 2rem);
    max-inline-size: 30ch;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.85rem;
  }

  /* Over the foot of the frame, on a shade so the small pictures read. */
  .stage__thumbs {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    display: flex;
    justify-content: safe center;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2.5rem clamp(0.75rem, 3vw, 1.5rem) clamp(0.75rem, 2vw, 1rem);
    background: linear-gradient(to top, rgb(0 0 0 / 0.6), transparent);
  }

  .stage__thumbs::-webkit-scrollbar {
    display: none;
  }

  .stage__thumb {
    flex: 0 0 clamp(2.5rem, 6vw, 3.75rem);
    overflow: hidden;
    border: 2px solid rgb(255 255 255 / 0.4);
    border-radius: 0.5rem;
    opacity: 0.55;
    transition:
      opacity 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .stage__thumb:hover {
    opacity: 0.85;
  }

  .stage__thumb[aria-current='true'] {
    border-color: #fff;
    opacity: 1;
    transform: translateY(-2px);
  }

  .stage__thumb :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
</style>

<script>
  import { onAlive } from '../../lib/alive';

  onAlive('[data-stage]', (node) => {
    const root = node as HTMLElement;
    const main = root.querySelector<HTMLElement>('[data-main]');
    const strip = root.querySelector<HTMLElement>('[data-thumbs]');
    if (!main || !strip) return;
    const thumbs = [...strip.querySelectorAll<HTMLAnchorElement>('.stage__thumb')];
    const n = thumbs.length;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;

    const mark = (i: number) => {
      if (i === active) return;
      active = i;
      thumbs.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      const t = thumbs[i];
      // Keep the chosen thumbnail in view, inside its own row only.
      strip.scrollTo({ left: t.offsetLeft - strip.clientWidth / 2 + t.offsetWidth / 2, behavior: still.matches ? 'auto' : 'smooth' });
    };

    const slides = [...main.querySelectorAll<HTMLElement>('.stage__slide')];
    const go = (i: number) => {
      const k = ((i % n) + n) % n;
      main.scrollTo({ left: slides[k].offsetLeft, behavior: still.matches ? 'auto' : 'smooth' });
    };
    /** The slide whose left edge is nearest the scroll position — gaps included. */
    const nearest = () => {
      let best = 0;
      slides.forEach((s, k) => {
        if (Math.abs(s.offsetLeft - main.scrollLeft) < Math.abs(slides[best].offsetLeft - main.scrollLeft)) best = k;
      });
      return best;
    };

    // The thumbnails are links for a page without a script; with one, they
    // move the frame and never the page.
    thumbs.forEach((t, i) =>
      t.addEventListener('click', (e) => {
        e.preventDefault();
        go(i);
      }),
    );

    let raf = 0;
    main.addEventListener(
      'scroll',
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          mark(nearest());
        });
      },
      { passive: true },
    );

    main.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(active + 1);
      else if (e.key === 'ArrowLeft') go(active - 1);
      else return;
      e.preventDefault();
    });
  });
</script>
