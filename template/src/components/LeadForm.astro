---
/**
 * The lead form — `@jtakeit/kit`'s, placed by this page.
 *
 * The markup is `renderLeadForm`'s and the in-place submission is the kit's
 * `<jtk-lead>` element; this component reads the site's words and the
 * collecting block's `asks`, and says where `/api/lead` is from here. It is
 * a real `<form method="post">` first: with JavaScript off the browser posts
 * to the same endpoint and the platform answers with a plain page.
 *
 * `novalidate` because the messages are ours, in the client's language, rather
 * than the browser's in the browser's. Every rule enforced here is enforced
 * again by the platform behind /api/lead — the endpoint is public and the
 * browser's checks are a convenience, not a gate.
 *
 * ── the words are the block's, the questions the catalogue's ────────────────
 *
 * `FORM` is the `cta_banner` block's own fields — the owner edits them by
 * tapping, which is what the paths annotate — and `asks` are declared once
 * in blocks.ts and drawn fixed, so the control on the page and the label in
 * the owner's inbox are the same declaration. See the comment on `asks` in
 * blocks.ts for what the platform holds the form to.
 */
import { renderLeadForm } from '@jtakeit/kit/lead';
import '@jtakeit/kit/lead.css';
import { copyFor } from '../copy';
import { localeOf, langOf, withLocale } from '../lib/locale';
import { site } from '../lib/site';
import { under } from '../lib/under';

const locale = localeOf(Astro.url.pathname);
const LANG = langOf(locale);
const { FORM, PAGE, WORDS_LANG } = copyFor(locale);

// The block's declaration, as the schema the platform reads has it
// (jtk/catalogue.json, through the door).
const block = site.type('cta_banner');
const declared = block?.asks ?? [];
// The photographs the form takes, as the block declares them (blocks.ts);
// the kit draws the picker in the page's language.
const photos = block?.photos ?? 0;
const asks = declared.map((ask) => ({
  key: ask.key,
  label: site.words(ask.label, LANG),
  // The declaration's words where they are not this page's language — one
  // label written once, in the site's own — say which they are.
  lang: site.wordsLang(ask.label, LANG) || undefined,
  kind: ask.kind,
  required: ask.required,
  max: ask.max,
  min: ask.min,
  options: (ask.options ?? []).map((value) => ({ value, label: site.words(ask.option_labels?.[value], LANG) })),
}));

// A path is undefined on a build without annotations, and the kit then
// writes no `data-jtk-path` at all.
//
// The paths are the home page's of this language: its copy reads the page
// at `/` (or `/de`), and `blocks[5].title` is that document's fifth
// block. On any other page the same path names a block that page does not
// have, and the annotation lint says so seventy times on a site of eleven
// pages (a bowling club, 8 October 2026). So the form annotates only where
// its block lives; elsewhere it is the same form, editable from the index.
const home = withLocale(locale, '/');
const onIndex = [home, `${home}/`, `/${LANG}`, `/${LANG}/`].includes(Astro.url.pathname.replace(/^\/p\/[^/]+/, '') || '/');
const at = (field: string) => (onIndex ? PAGE.block('cta_banner').at(field)['data-jtk-path'] : undefined);
const paths = {
  title: at('title'),
  lead: at('lead'),
  name_label: at('name_label'),
  contact_label: at('contact_label'),
  message_label: at('message_label'),
  required_note: at('required_note'),
  cta_label: at('cta_label'),
};

const html = renderLeadForm({ action: under('/api/lead'), copy: FORM, asks, paths, photos, lang: LANG, wordsLang: WORDS_LANG });
---

<Fragment set:html={html} />

<script>
  import '@jtakeit/kit/elements/lead';
</script>
