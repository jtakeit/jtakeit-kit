---
/**
 * One page of the listing of a collection with pages — `/works`, and
 * `/works/page/2` once there are more than its `per_page` (the address, and
 * why not `/works/2`, are argued in lib/entries above `ownListing`).
 *
 * Drawn by `[...listing].astro` for page one and `[...listing]/page/[page].astro`
 * for the rest, so both are one page. Only for a collection that says
 * `listing: true` (`drawsPagedListing`, the door's); one whose repository wrote its own listing —
 * the blog's — is not drawn here at all.
 *
 * Grouped where the collection has a `group`, as a listing without pages is:
 * the page's entries under their headings, a category's title annotated as
 * that category's, a select's label fixed. The entries arrive already in the
 * grouped order and cut to this page (`site.listingPages`), so a heading's run
 * that crosses the cut opens page two under the same heading.
 *
 * Annotated as every listing is: an entry's words with its own annotation
 * (`EntryCard.astro`), the collection's label and the way between pages fixed —
 * the repository's words, in the page's language (`LISTING` in src/copy).
 */
import Layout from '../layouts/Layout.astro';
import EntryCard from './EntryCard.astro';
import { listingHref, type Collection, type Entry } from '../lib/entries';
import { langOf } from '../lib/locale';
import { site } from '../lib/site';
import { copyFor } from '../copy';

interface Props {
  collection: Collection;
  locale: string;
  /** This page's entries, in the listing's order. */
  entries: Entry[];
  current: number;
  last: number;
  alternates: { locale: string; address: string }[];
}

const { collection, locale, entries, current, last, alternates } = Astro.props;
const { LISTING, WORDS_LANG } = copyFor(locale);
const heading = site.words(collection.label, langOf(locale));
const groups = site.groupsOf(collection.name, entries, locale) ?? [{ entries }];
const isGrouped = groups.some((one) => one.heading !== undefined);
// The page the listing is, where the content has one: its SEO and its name,
// in this language (the door lays the translation over the original).
const listedAtBase = site.listingOf(collection.name, '');
const ownPage = listedAtBase === undefined ? undefined : site.page(listedAtBase, locale);
const seoWords = (key: string): string => (typeof ownPage?.seo[key] === 'string' ? (ownPage.seo[key] as string).trim() : '');
const named = seoWords('title') || ownPage?.name?.trim() || heading;
const title = current > 1 ? `${named} — ${LISTING.pageOf(current, last)}` : named;
---

<Layout title={title} description={seoWords('description')} alternates={alternates}>
  <main id="content">
    <section class="listing listing--posts" data-collection={collection.name}>
      {/* The collection's own name, from the catalogue: fixed. */}
      <h1 data-jtk-fixed>{heading}</h1>
      {
        groups.map((run) => (
          <Fragment>
            {run.heading && (
              <h2 class="listing-group" {...run.heading.at} {...(run.heading.entry?.fields.lang('title') ?? {})} data-jtk-fixed={run.heading.fixed ? true : undefined}>{run.heading.text}</h2>
            )}
            <ul class="posts">
              {run.entries.map((entry) => <EntryCard entry={entry} locale={locale} level={isGrouped ? 'h3' : 'h2'} />)}
            </ul>
          </Fragment>
        ))
      }
      {
        last > 1 && (
          <nav class="listing-pager" lang={WORDS_LANG || undefined}>
            {current > 1 ? <a href={listingHref(collection.name, locale, current - 1)} rel="prev" data-jtk-fixed>{LISTING.previous}</a> : <span />}
            <span data-jtk-fixed>{LISTING.pageOf(current, last)}</span>
            {current < last ? <a href={listingHref(collection.name, locale, current + 1)} rel="next" data-jtk-fixed>{LISTING.next}</a> : <span />}
          </nav>
        )
      }
    </section>
  </main>
</Layout>
