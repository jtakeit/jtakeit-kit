---
/**
 * One entry as a tile of a listing — the blog's, and every collection's with
 * pages (`EntryListing.astro`). Linked to the entry's page.
 *
 * It draws the reserved keys an entry may have (docs/collections.md): the
 * cover, the date, the title, the excerpt — whichever the type declares and
 * the entry fills in. Each is that entry's words, not the listing's, so what
 * the owner edits by tapping carries the entry's own annotation as the door
 * writes it for a tile (`page:/blog/first-look:blocks[0].title`), and a tap
 * opens the entry. The date and the excerpt are `no_tap_target` on a post —
 * edited in the panel beside it, and a tap on them refused by the platform's
 * build — so they are drawn `data-jtk-fixed`, and so is a title the type
 * keeps from the owner.
 *
 * Plain, like the rest: the design pass restyles `.post-card` and keeps
 * every annotation.
 */
import { Image } from 'astro:assets';
import { href, titleOf, type Entry } from '../lib/entries';
import { langOf } from '../lib/locale';
import { isUpload, uploaded } from '../lib/uploads';
import { photo } from '../lib/photos';

interface Props {
  entry: Entry;
  locale: string;
  /** The title's level: `h2` on a flat listing, `h3` under a group's heading. */
  level?: 'h2' | 'h3';
}

const { entry, locale, level = 'h2' } = Astro.props;
const Title = level;
const { fields } = entry;
const declared = (key: string) => fields.field(key);

const title = titleOf(entry);

// The cover, its words — `cover_alt` beside it where the type has one, else
// the entry's title — and its annotation where it is the owner's to tap.
const picture = declared('cover')?.kind === 'media' ? fields.picture('cover') : undefined;
const cover = picture?.src ? (isUpload(picture.src) ? uploaded(picture.src) : photo(picture.src)) : undefined;
const coverAt = fields.tappable('cover') ? picture?.['data-jtk-path'] : undefined;

const when = new Intl.DateTimeFormat(langOf(locale), { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const date = fields.value('date');
const day = declared('date') ? new Date(String(date ?? '')) : new Date(Number.NaN);
const dated = Number.isNaN(day.getTime()) ? '' : when.format(day);

const excerpt = declared('excerpt') && typeof fields.value('excerpt') === 'string' ? (fields.value('excerpt') as string) : '';
---

<li class="post-card">
  <a href={href(entry)}>
    {cover && <Image src={cover} alt={picture?.alt ?? ''} data-jtk-path={coverAt} widths={[480, 960]} sizes="(min-width: 900px) 30rem, 92vw" layout="none" />}
    {dated && <time datetime={String(date)} data-jtk-fixed>{dated}</time>}
    <Title {...title.at} data-jtk-fixed={title.fixed ? true : undefined}>{title.text}</Title>
    {excerpt !== '' && <p data-jtk-fixed>{excerpt}</p>}
  </a>
</li>
